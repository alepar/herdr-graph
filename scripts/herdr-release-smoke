#!/usr/bin/env python3
"""Qualify graph with checksum-pinned private Herdr releases on macOS or Linux.

Builds once, then runs 30 graph E2E + 5 Herdr API + 2 actual threads cases per
release. No model launches. See docs/validation/herdr-release-matrix.md.
"""
from __future__ import annotations

import argparse
import concurrent.futures
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import shutil
import shlex
import signal
import stat
import subprocess
import sys
import tempfile
import threading
import time
import urllib.request
import uuid

ROOT = Path(__file__).resolve().parent.parent
LIST = ROOT / 'tests/herdr-releases.tsv'
REPO = 'herdrdev/herdr'
FLOOR = (0, 9, 1)
# Short shared temp dir, matching graph's config::tmp_dir(): canonical /tmp on macOS.
TMP = '/private/tmp' if platform.system() == 'Darwin' else '/tmp'
ASSETS = ('herdr-linux-aarch64', 'herdr-linux-x86_64', 'herdr-macos-aarch64', 'herdr-macos-x86_64')
STOP = threading.Event()
SUITES = {
    'e2e_private_herdr': (
        'e2e_create_teamspace_seats_tabs_panes_env',
        'e2e_rename_tab_renames_seat_moves_path_history',
        'e2e_close_pane_retires_clone', 'e2e_close_tab_retires_seat_and_clones',
        'e2e_close_workspace_retires_all_incl_dormant',
        'e2e_undo_tab_close_restores_in_new_tab', 'e2e_undo_from_bound_pane_adopts_and_keeps_it',
        'e2e_undo_from_pane_adopts_caller_pane', 'e2e_undo_tab_close_from_pane_adopts_caller_pane',
        'e2e_template_edit_adds_member_new_tab', 'e2e_application_retire_closes_exclusive_seats',
        'e2e_retire_last_clone_induced_seat_retirement_once', 'e2e_seat_deactivate_closes_tab_no_retirement',
        'e2e_move_only_pane_moved_out_no_recreate', 'e2e_move_pane_into_other_seat_tab_keeps_that_seats_name',
        'e2e_close_while_daemon_down_unknown_not_recreated', 'e2e_rename_while_daemon_down_recorded',
        'e2e_daemon_kill_mid_op_recovers_no_duplicates', 'e2e_event_loss_reconnect_converges',
        'e2e_dropped_rename_recovered', 'e2e_herdr_restart_rebind_no_mass_retirement_no_duplicates',
        'e2e_rebind_restamps_token_after_herdr_restart', 'e2e_seat_resolution_in_bound_pane',
        'e2e_restored_panes_resolve_without_env', 'e2e_summary_lands_in_archived_seat_folder',
        'e2e_seat_override_model_change_recorded_shell_not_replaced', 'e2e_participation_join_leave_scopes',
        'e2e_cancel_and_reassign_rejected_op', 'e2e_resurrect_retired_seat',
        'e2e_plugin_link_status_action_single_daemon',
    ),
    'herdr_client': (
        'private_create_tab_panes_with_env_snapshot_matches', 'private_events_created_renamed_closed',
        'private_snapshot_after_reconnect', 'private_process_info_is_shell', 'private_agent_absent_and_rejections',
    ),
    'threads_real': (
        'real_threads_channel_invite_membership_notify_release', 'production_discovery_reaches_real_threads_daemon',
    ),
}


def safe_environment(source=None):
    """Keep build tools usable while dropping credentials and live seat/service routing."""
    return {k: v for k, v in (os.environ if source is None else source).items()
            if not k.startswith(('ANTHROPIC_', 'OPENAI_', 'HERDR_', 'CLAUDE_', 'HT_', 'HG_'))}


def vkey(version):
    if not re.fullmatch(r'(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)', version):
        raise ValueError(f'not stable semver: {version!r}')
    return tuple(map(int, version.split('.')))


def validate_releases(releases):
    if not releases:
        raise ValueError('no stable releases at or above floor')
    for version, assets in releases.items():
        if vkey(version) < FLOOR:
            raise ValueError(f'version below floor: {version}')
        missing = set(ASSETS) - assets.keys()
        if missing:
            raise ValueError(f'{version}: missing assets {sorted(missing)}')
        if set(assets) != set(ASSETS):
            raise ValueError(f'{version}: unsupported assets')
        if any(not re.fullmatch('[0-9a-f]{64}', digest) for digest in assets.values()):
            raise ValueError(f'{version}: invalid sha256')
    return dict(sorted(releases.items(), key=lambda item: vkey(item[0])))


def read_list(path=LIST):
    releases = {}
    for line in path.read_text().splitlines():
        if not line.strip() or line.startswith('#'):
            continue
        version, asset, digest = line.split('\t')
        assets = releases.setdefault(version, {})
        if asset in assets:
            raise ValueError(f'duplicate {version} {asset}')
        assets[asset] = digest
    return validate_releases(releases)


def release_metadata(payload):
    releases = {}
    for release in payload:
        if release.get('draft') or release.get('prerelease'):
            continue
        version = release['tag_name'].removeprefix('v')
        try:
            if vkey(version) < FLOOR:
                continue
        except ValueError:
            continue
        assets = {}
        for asset in release['assets']:
            if asset['name'] in ASSETS:
                digest = asset.get('digest') or ''
                if not digest.startswith('sha256:') or asset['name'] in assets:
                    raise ValueError(f'{version}: missing/duplicate official digest for {asset["name"]}')
                assets[asset['name']] = digest[7:]
        if version in releases:
            raise ValueError(f'duplicate official release {version}')
        releases[version] = assets
    return validate_releases(releases)


def upstream():
    payload = []
    page = 1
    while True:
        request = urllib.request.Request(
            f'https://api.github.com/repos/{REPO}/releases?per_page=100&page={page}',
            headers={'Accept': 'application/vnd.github+json', 'User-Agent': 'herdr-graph-matrix'})
        with urllib.request.urlopen(request, timeout=60) as response:
            batch = json.load(response)
        if not isinstance(batch, list):
            raise ValueError('unexpected GitHub release response')
        payload.extend(batch)
        if len(batch) < 100:
            return release_metadata(payload)
        page += 1


def upstream_problems(listed, remote):
    problems = [f'missing from list: {v}' for v in remote if v not in listed]
    problems += [f'listed but no longer official: {v}' for v in listed if v not in remote]
    problems += [f'digest differs: {v} {a}' for v in remote if v in listed
                 for a, digest in remote[v].items() if listed[v].get(a) != digest]
    return problems


def write_list(releases, path=LIST):
    rows = ['# Official herdrdev/herdr stable releases >= 0.9.1; GitHub asset SHA-256 digests.',
            '# Source: https://api.github.com/repos/herdrdev/herdr/releases (paginated).',
            '# Refresh: scripts/herdr-release-smoke --update; runtime qualification remains required.',
            '# Version\tasset\tsha256; Linux rows pin downloads and do not imply Linux qualification.']
    rows += [f'{v}\t{a}\t{digest}' for v, assets in validate_releases(releases).items()
             for a, digest in sorted(assets.items())]
    path.write_text('\n'.join(rows) + '\n')


def sha256(path):
    digest = hashlib.sha256()
    with path.open('rb') as source:
        for chunk in iter(lambda: source.read(1 << 20), b''):
            digest.update(chunk)
    return digest.hexdigest()


def run_process(argv, env, timeout, log, observe=None):
    """Bound the runner group; separate fixture groups are handled by cleanup_owned."""
    started = time.monotonic()
    timed_out = False
    cancelled = False
    next_observation = 0.0
    with log.open('w') as output:
        child = subprocess.Popen([str(arg) for arg in argv], cwd=ROOT, env=env,
                                 stdin=subprocess.DEVNULL, stdout=output, stderr=subprocess.STDOUT,
                                 start_new_session=True)
        try:
            while child.poll() is None:
                if observe is not None and time.monotonic() >= next_observation:
                    observe()
                    next_observation = time.monotonic() + 0.15
                timed_out = time.monotonic() - started > timeout
                cancelled = STOP.is_set()
                if timed_out or cancelled:
                    os.killpg(child.pid, signal.SIGTERM)
                    try:
                        child.wait(timeout=2)
                    except subprocess.TimeoutExpired:
                        os.killpg(child.pid, signal.SIGKILL)
                        child.wait(timeout=5)
                    break
                time.sleep(0.05)
        finally:
            if child.poll() is None:
                os.killpg(child.pid, signal.SIGKILL)
                child.wait(timeout=5)
    return {'returncode': child.returncode, 'timed_out': timed_out, 'cancelled': cancelled,
            'seconds': round(time.monotonic() - started, 3), 'pid': child.pid, 'pgid': child.pid}


def verify_binary(binary, version, digest):
    if sha256(binary) != digest:
        raise RuntimeError(f'checksum mismatch for {binary}; evidence preserved')
    if not binary.is_absolute() or not os.access(binary, os.X_OK):
        raise RuntimeError(f'not an absolute executable: {binary}')
    with tempfile.TemporaryDirectory(prefix='hgm-version-', dir=TMP) as root:
        log = Path(root) / 'version.log'
        run = run_process([binary, '--version'], safe_environment(), 10, log)
        reported = log.read_text().strip()
    if run['returncode'] != 0 or run['timed_out'] or run['cancelled'] or reported != f'herdr {version}':
        raise RuntimeError(f'{binary} reports {reported!r}, exit {run["returncode"]}; expected herdr {version}')


def fetch(version, asset, digest, cache):
    binary = cache / version / asset.removeprefix('herdr-') / 'herdr'
    if binary.exists():
        verify_binary(binary, version, digest)
        return binary
    binary.parent.mkdir(parents=True, exist_ok=True)
    # The threads cache is a read-only source. Never chmod, remove, or replace its artifacts.
    external = Path.home() / '.cache/herdr-threads/herdr-releases' / version / asset.removeprefix('herdr-') / 'herdr'
    fd, part_name = tempfile.mkstemp(prefix='herdr-', suffix='.part', dir=binary.parent)
    os.close(fd)
    part = Path(part_name)
    try:
        if external.is_file():
            shutil.copyfile(external, part)
        else:
            url = f'https://github.com/{REPO}/releases/download/v{version}/{asset}'
            with urllib.request.urlopen(url, timeout=60) as response, part.open('wb') as out:
                shutil.copyfileobj(response, out)
        part.chmod(0o755)
        verify_binary(part, version, digest)
        part.replace(binary)
    except Exception as error:
        raise RuntimeError(f'could not verify {version} {asset}: {error}; retained {part}') from error
    return binary


def classify_suite(returncode, output, expected):
    results = re.findall(r'^test (\S+) \.\.\. (\S+)\s*$', output, re.M)
    cases = {name: ('PASS' if status == 'ok' else 'FAIL') for name, status in results}
    summaries = re.findall(r'^test result: ok\. (\d+) passed; (\d+) failed; (\d+) ignored; '
                           r'(\d+) measured; (\d+) filtered out;', output, re.M)
    panic = re.search(r"^\s*thread '[^\r\n]*' (?:\(\d+\) )?panicked at(?:\s|:)", output, re.M)
    valid = (returncode == 0 and panic is None and len(results) == len(expected) and
             set(cases) == set(expected) and all(status == 'ok' for _, status in results) and
             summaries == [(str(len(expected)), '0', '0', '0', '0')] and
             not re.search(r'SKIPPED:|isolation violations|PrivateHerdr teardown:', output))
    return {'status': 'PASS' if valid else 'FAIL', 'cases': cases,
            'expected': list(expected), 'observed_count': len(results),
            'detail': ('Rust panic diagnostic in runtime output' if panic else
                       '' if valid else 'exit/result inventory/summary/skip or teardown check failed')}


def process_snapshot():
    """Only inspect: environment is kept in memory, never emitted to logs/reports."""
    # procps refuses the mixed BSD/Unix `-ax` form; BSD ps keeps it.
    ax = '-ax' if platform.system() == 'Darwin' else 'ax'
    run = subprocess.run(['/bin/ps', 'eww', ax, '-o', 'pid=,ppid=,pgid=,stat=,lstart=,command='],
                         env={'PATH': '/usr/bin:/bin'}, capture_output=True, text=True, timeout=10)
    if run.returncode:
        raise RuntimeError('cannot inspect owned processes for cleanup')
    processes = {}
    for line in run.stdout.splitlines():
        match = re.match(r'\s*(\d+)\s+(\d+)\s+(\d+)\s+(\S+)\s+(\S+\s+\S+\s+\d+\s+[\d:]+\s+\d+)\s+(.*)', line)
        if match:
            pid, ppid, pgid, state, started, command = match.groups()
            markers = re.findall(r'(?:^|\s)HG_TEST_ROOT=([^\s]+)(?=\s|$)', command)
            processes[int(pid)] = {'started': ' '.join(started.split()), 'roots': markers,
                                   'ppid': int(ppid), 'pgid': int(pgid), 'state': state, 'program': command.split(' ', 1)[0]}
    if os.getpid() not in processes:
        raise RuntimeError('cannot parse own process identity; cleanup inspection is unavailable')
    return processes


def registry_ownership(registry, owner):
    errors, roots, registered = [], [], []
    if registry.exists():
        for line in registry.read_text().splitlines():
            try:
                entry = json.loads(line)
                root = Path(entry['root'])
                if (not re.fullmatch(re.escape(TMP) + r'/(?:hg|hgt)-[a-z0-9]+', str(root)) or
                        root.is_symlink() or (root / '.matrix-owner').read_text() != owner):
                    raise ValueError('root lacks exact run ownership')
                if root not in roots:
                    roots.append(root)
                if entry.get('pid'):
                    registered.append({'pid': entry['pid'], 'started': entry['started']})
            except (OSError, ValueError, KeyError) as error:
                errors.append(f'invalid owned registry entry: {error}')
    return roots, registered, errors


def observe_owned(registry, owner, tracked):
    """Retain proven identities before daemon parents can exit/reparent children."""
    roots, registered, errors = registry_ownership(registry, owner)
    if errors:
        raise RuntimeError('; '.join(errors))
    root_names = {str(root) for root in roots}
    snapshot = process_snapshot()
    anchors = {pid for pid, info in snapshot.items() if root_names.intersection(info['roots'])}
    anchors.update(entry['pid'] for entry in registered
                   if snapshot.get(entry['pid'], {}).get('started') == entry['started'])
    anchors.update(pid for pid, started in tracked.items()
                   if snapshot.get(pid, {}).get('started') == started)
    # macOS hides SIP-protected shell environments: use proven ancestry while
    # its owned parent is still alive, then retain each child's start identity.
    while True:
        descendants = {pid for pid, info in snapshot.items() if info['ppid'] in anchors}
        if descendants <= anchors:
            break
        anchors.update(descendants)
    for pid in anchors - {os.getpid()}:
        tracked[pid] = snapshot[pid]['started']
    return {pid: info for pid, info in snapshot.items()
            if pid in tracked and tracked[pid] == info['started']}


def cleanup_owned(registry, owner, tracked=None):
    """Revalidate exact root ownership + PID start identity before every signal.

    Roots are registered before spawn, so root-marker fallback also catches a
    server killed between spawn and PID publication. Periodic observations retain
    protected descendants before their owned parents can exit.
    """
    roots, registered, errors = registry_ownership(registry, owner)
    tracked = {} if tracked is None else tracked
    reaped = set()
    initial = {}
    try:
        initial = observe_owned(registry, owner, tracked)
        began = time.monotonic()
        while True:
            current = observe_owned(registry, owner, tracked)
            if not current or time.monotonic() - began > 8:
                break
            for pid, info in current.items():
                if process_snapshot().get(pid, {}).get('started') != info['started']:
                    continue
                try:
                    os.kill(pid, signal.SIGKILL if time.monotonic() - began > 2 else signal.SIGTERM)
                    reaped.add(pid)
                except ProcessLookupError:
                    pass
            time.sleep(0.05)
        survivors = sorted(observe_owned(registry, owner, tracked))
        if survivors:
            errors.append(f'owned processes survived cleanup: {survivors}')
        # Emergency reaping preserves safety but still fails qualification.
        if initial:
            errors.append(f'fixture leaked processes before emergency cleanup: {sorted(initial)}')
        for root in roots:
            violation = root / 'isolation-violations.log'
            if violation.exists() and violation.read_text().strip():
                errors.append(f'isolation violations: {violation}')
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        survivors = []
        errors.append(f'cleanup inspection failed: {error}')
    return {'clean': not errors, 'errors': errors, 'roots': [str(root) for root in roots],
            'registered_pids': registered, 'observed_pids': tracked,
            'leaked': {pid: {k: v for k, v in info.items() if k != 'roots'} for pid, info in initial.items()},
            'reaped': sorted(reaped), 'survivors': survivors}


# Only actual runtime diagnostic destinations. Never walk graph content, Git,
# transcripts, or plugin packages. The plugin daemon uses the graph log too.
THREADS_DIAGNOSTIC_NODES = (
    'threads-state/node',
    'home/.local/state/herdr/plugins/herdr-threads/node',
    'home/.local/state/herdr/plugins/herdr-threads/saved-old-node',
)


def open_owned(root_fd, relative, directory=False):
    """Open every component relative to a pinned owned root, refusing symlinks.

    No resolve/glob/rglob: neither a file nor an intermediate directory can
    redirect inspection outside that root, including during a rename race.
    """
    parts = Path(relative).parts
    if not parts or Path(relative).is_absolute() or any(p in ('.', '..') for p in parts):
        raise ValueError(f'invalid relative diagnostic path: {relative}')
    fd = os.dup(root_fd)
    try:
        for index, part in enumerate(parts):
            is_dir = index < len(parts) - 1 or directory
            flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
            if is_dir:
                flags |= os.O_DIRECTORY
            child = os.open(part, flags, dir_fd=fd)
            os.close(fd)
            fd = child
        if not directory and not stat.S_ISREG(os.fstat(fd).st_mode):
            raise OSError(f'not a regular diagnostic file: {relative}')
        return fd
    except BaseException:
        os.close(fd)
        raise


def inspect_diagnostics(roots, owner, destination, profile=None):
    """Called only after cleanup/quiescence; archive exact bytes before PASS.

    Missing Herdr stderr or internal server logs always fail. Graph suites require graph daemon logs;
    threads suites require all three exercised nodes (including the saved node).
    Optional destinations are still inspected when present. Existing node
    directories require their daemon log and at least one startup-attempt log.
    """
    destination.mkdir()
    errors, files, absent = [], [], []
    nodes = 0
    plugins = 0
    for root_name in roots:
        root = Path(root_name)
        root_fd = None
        try:
            root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            with os.fdopen(open_owned(root_fd, '.matrix-owner')) as marker:
                if marker.read() != owner:
                    raise ValueError('root ownership changed before diagnostic inspection')

            def capture(relative, required=True):
                try:
                    fd = open_owned(root_fd, relative)
                    with os.fdopen(fd, 'rb') as source:
                        data = source.read()
                    target = destination / root.name / relative
                    target.parent.mkdir(parents=True, exist_ok=True)
                    target.write_bytes(data)
                    panic = re.search(rb"(?:^|\n)\s*thread '[^\r\n]*' (?:\(\d+\) )?panicked at(?:\s|:)", data)
                    files.append({'root': str(root), 'relative': relative,
                                  'archive': str(target), 'bytes': len(data),
                                  'sha256': hashlib.sha256(data).hexdigest(), 'panic': bool(panic)})
                    if panic:
                        errors.append(f'Rust panic diagnostic: {root / relative}')
                except FileNotFoundError as error:
                    if required:
                        errors.append(f'required diagnostic missing: {root / relative}: {error}')
                    else:
                        absent.append(str(root / relative))
                except (OSError, ValueError) as error:
                    errors.append(f'diagnostic inspection failed: {root / relative}: {error}')

            capture('herdr.log')
            capture('config/herdr/herdr-server.log')
            # Herdr's tracing writer uses this fixed directory and numeric
            # rotations, separately from the server's captured stdout/stderr.
            logs_fd = open_owned(root_fd, 'config/herdr', directory=True)
            try:
                names = sorted(os.listdir(logs_fd))
            finally:
                os.close(logs_fd)
            for name in names:
                if (name != 'herdr-server.log' and
                        re.fullmatch(r'herdr(?:-server|-client)?\.log(?:\.[1-9]\d*)?', name)):
                    capture('config/herdr/' + name)
            capture('graph/.graph-local/daemon.log', required=profile == 'e2e_private_herdr')
            try:
                fd = open_owned(root_fd, 'plugin', directory=True)
                os.close(fd)
            except FileNotFoundError:
                absent.append(str(root / 'plugin-diagnostics.log'))
            else:
                plugins += 1
                capture('plugin-diagnostics.log')
            for node in THREADS_DIAGNOSTIC_NODES:
                try:
                    fd = open_owned(root_fd, node, directory=True)
                    os.close(fd)
                except FileNotFoundError:
                    absent.append(str(root / node))
                    continue
                nodes += 1
                capture(node + '/daemon.log')
                capture(node + '/daemon.log.1', required=False)
                logs_fd = open_owned(root_fd, node + '/logs', directory=True)
                try:
                    names = sorted(os.listdir(logs_fd))
                finally:
                    os.close(logs_fd)
                startup = [name for name in names if re.fullmatch(r'startup-\d+-[0-9a-f]{8}\.log', name)]
                if not startup:
                    errors.append(f'required startup diagnostics missing: {root / node / "logs"}')
                for name in startup:
                    capture(node + '/logs/' + name)
        except (OSError, ValueError) as error:
            errors.append(f'diagnostic inventory failed: {root}: {error}')
        finally:
            if root_fd is not None:
                os.close(root_fd)
    if profile == 'e2e_private_herdr' and plugins != 1:
        errors.append(f'expected 1 private plugin diagnostic destination, got {plugins}')
    if profile == 'threads_real' and nodes != 3:
        errors.append(f'expected 3 runtime threads diagnostic nodes, got {nodes}')
    return {'clean': not errors, 'errors': errors, 'files': files, 'absent_optional': absent,
            'threads_nodes': nodes, 'private_plugins': plugins, 'profile': profile,
            'excluded': ['graph content and Git objects', 'native transcripts', 'plugin package files'],
            'contract': 'bounded known destinations, no symlinks, exact raw bytes after owned process cleanup'}


def run_suite(executable, expected, env, directory, timeout, expected_roots=0, diagnostic_profile=None):
    directory.mkdir(parents=True, exist_ok=False)
    registry = directory / 'roots.jsonl'
    owner = uuid.uuid4().hex
    run_env = safe_environment(env)
    run_env.update({k: v for k, v in env.items() if k in ('HG_TEST_HERDR_BINARY', 'HG_TEST_THREADS_BINARY')})
    run_env.update(HG_HERDR_MATRIX='1', HG_REAL_THREADS='1', HG_KEEP_PRIVATE_ROOT='1',
                   HG_MATRIX_REGISTRY=str(registry), HG_MATRIX_OWNER=owner)
    tools = directory / 'forbidden-tools'
    tools.mkdir()
    tool_log = tools / 'invocations.log'
    for tool in ('cargo', 'claude', 'codex', 'gemini', 'opencode'):
        guard = tools / tool
        guard.write_text("#!/bin/sh\n" +
                         f"echo {shlex.quote(tool)} >> {shlex.quote(str(tool_log))}\n" +
                         "echo 'matrix forbids Cargo and native model launches after prebuild' >&2\nexit 97\n")
        guard.chmod(0o755)
    run_env['PATH'] = str(tools) + os.pathsep + run_env.get('PATH', '/usr/bin:/bin')
    run_env['CARGO'] = str(tools / 'cargo')
    log = directory / 'output.log'
    result = {'status': 'FAIL', 'expected': list(expected)}
    tracked = {}
    try:
        run = run_process([executable, '--test-threads=1', '--show-output', '--format=pretty'], run_env, timeout, log,
                          observe=lambda: observe_owned(registry, owner, tracked))
        result.update(classify_suite(run['returncode'], log.read_text(errors='replace'), expected))
        result.update(run)
        if tool_log.exists():
            result.update(status='FAIL', detail='forbidden tool invocation: ' + tool_log.read_text().strip())
        if run['timed_out'] or run['cancelled']:
            result.update(status='FAIL', detail='suite deadline exceeded or interrupted')
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        result.update(status='FAIL', detail=str(error))
    finally:
        cleanup = cleanup_owned(registry, owner, tracked)
        (directory / 'cleanup.json').write_text(json.dumps(cleanup, indent=2) + '\n')
        result['cleanup'] = cleanup
        if expected_roots and len(cleanup['roots']) != expected_roots:
            result.update(status='FAIL', detail=f'expected {expected_roots} runtime fixture roots, got {len(cleanup["roots"])}')
        if not cleanup['clean']:
            result.update(status='FAIL', detail='cleanup gate failed: ' + '; '.join(cleanup['errors']))
    try:
        diagnostics = inspect_diagnostics(cleanup.get('roots', []), owner, directory / 'diagnostics',
                                          diagnostic_profile)
    except (OSError, ValueError) as error:
        diagnostics = {'clean': False, 'errors': [f'diagnostic preservation failed: {error}']}
    result['diagnostics'] = diagnostics
    (directory / 'diagnostics.json').write_text(json.dumps(diagnostics, indent=2) + '\n')
    if not diagnostics['clean']:
        result.update(status='FAIL', detail='diagnostic gate failed: ' + '; '.join(diagnostics['errors']))
    if result['status'] == 'PASS':
        try:
            for root in cleanup['roots']:
                if (Path(root) / '.matrix-owner').read_text() != owner:
                    raise RuntimeError(f'root ownership changed before removal: {root}')
                shutil.rmtree(root)
        except (OSError, RuntimeError) as error:
            cleanup['clean'] = False
            cleanup['errors'].append(f'owned root removal failed: {error}')
            result.update(status='FAIL', detail=cleanup['errors'][-1])
    result['log'] = str(log)
    (directory / 'cleanup.json').write_text(json.dumps(cleanup, indent=2) + '\n')
    (directory / 'result.json').write_text(json.dumps(result, indent=2) + '\n')

    return result


def validate_inventory(executable, expected, env):
    with tempfile.TemporaryDirectory(prefix='hgm-inventory-', dir=TMP) as root:
        log = Path(root) / 'inventory.log'
        run = run_process([executable, '--list', '--format=terse'], env, 15, log)
        actual = re.findall(r'^(\S+): test$', log.read_text(), re.M)
    if (run['returncode'] != 0 or run['timed_out'] or len(actual) != len(expected) or set(actual) != set(expected)):
        raise RuntimeError(f'{executable}: inventory differs; expected {len(expected)}, observed {actual}')


def build_once(env, directory):
    """All Cargo completes here, sequentially, before any release worker starts."""
    directory.mkdir(parents=True, exist_ok=True)
    graph_log = directory / 'graph-build.log'
    args = ['cargo', 'test', '--locked', '--offline', '--features', 'private-herdr', '--no-run',
            '--message-format=json-render-diagnostics']
    for suite in SUITES:
        args += ['--test', suite]
    run = run_process(args, env, 1200, graph_log)
    if run['returncode'] or run['timed_out'] or run['cancelled']:
        raise RuntimeError(f'graph build failed: {graph_log}')
    executables = {}
    for line in graph_log.read_text().splitlines():
        try:
            message = json.loads(line)
        except ValueError:
            continue
        name = message.get('target', {}).get('name')
        if (message.get('reason') == 'compiler-artifact' and name in SUITES
                and message.get('executable') and message.get('profile', {}).get('test')):
            executables[name] = Path(message['executable']).resolve()
    if set(executables) != set(SUITES):
        raise RuntimeError(f'missing graph test executables: {graph_log}')
    threads_target = ROOT / 'target/threads-bin'
    threads_log = directory / 'threads-build.log'
    run = run_process(['cargo', 'build', '--locked', '--offline', '--manifest-path',
                       ROOT / 'third_party/herdr-threads/Cargo.toml', '--bin', 'herdr-threads',
                       '--target-dir', threads_target], env, 1200, threads_log)
    if run['returncode'] or run['timed_out'] or run['cancelled']:
        raise RuntimeError(f'threads fixture build failed: {threads_log}')
    threads = (threads_target / 'debug/herdr-threads').resolve(strict=True)
    for name, executable in executables.items():
        validate_inventory(executable, SUITES[name], env)
    return executables, threads


def host_asset():
    system = {'Darwin': 'macos', 'Linux': 'linux'}.get(platform.system())
    if system is None:
        raise RuntimeError(f'unsupported host operating system: {platform.system()}')
    arch = {'arm64': 'aarch64', 'aarch64': 'aarch64', 'x86_64': 'x86_64'}.get(platform.machine())
    if arch is None:
        raise RuntimeError(f'unsupported host architecture: {platform.machine()}')
    return f'herdr-{system}-{arch}'


def write_reports(report, payload):
    report.parent.mkdir(parents=True, exist_ok=True)
    json_path = report.with_suffix('.json')
    markdown_path = report.with_suffix('.md')
    json_path.write_text(json.dumps(payload, indent=2) + '\n')
    lines = [f'Herdr graph release matrix at {payload["head"]} ({payload["asset"]})', '',
             'Private shell and synthetic-hook qualification; no native model launches.', '',
             '| Herdr | Result | graph E2E (30) | Herdr API (5) | actual threads (2) |',
             '| --- | --- | --- | --- | --- |']
    for row in payload['releases']:
        lines.append('| ' + ' | '.join([row['version'], row['status']] +
                     [row.get('suites', {}).get(name, {}).get('status', 'FAIL') for name in SUITES]) + ' |')
    for row in payload['releases']:
        if row.get('error'):
            lines += ['', f'{row["version"]}: {row["error"]}']
    lines += ['', f'Aggregate result: {payload["status"]}.', '', f'Logs: {payload["logs"]}']
    markdown_path.write_text('\n'.join(lines) + '\n')
    print('\n'.join(lines), flush=True)


def main():
    # Drop keys in the driver itself before spawning any build/test process.
    for key in list(os.environ):
        if key.startswith(('ANTHROPIC_', 'OPENAI_')):
            del os.environ[key]
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--list', action='store_true')
    parser.add_argument('--versions', nargs='+')
    parser.add_argument('--cache', type=Path, default=Path(f'{TMP}/herdr-graph-releases-{os.getuid()}'))
    parser.add_argument('--report', type=Path, help='report stem (writes .json, .md and .logs/)')
    parser.add_argument('--jobs', type=int, default=2)
    parser.add_argument('--timeout', type=float, default=900, help='deadline per suite in seconds (default 900)')
    parser.add_argument('--check-upstream', action='store_true')
    parser.add_argument('--update', action='store_true')
    args = parser.parse_args()
    if args.jobs < 1 or args.timeout <= 0:
        parser.error('--jobs and --timeout must be positive')
    listed = read_list()
    if args.list:
        print('\n'.join(listed))
        return 0
    if args.check_upstream or args.update:
        remote = upstream()
        if args.update:
            write_list(remote)
            print(f'updated {LIST}; run qualification before claiming support')
            return 0
        problems = upstream_problems(listed, remote)
        for problem in problems:
            print(problem, file=sys.stderr)
        print('official stable versions: ' + ', '.join(remote))
        return int(bool(problems))
    versions = args.versions or list(listed)
    if len(set(versions)) != len(versions):
        parser.error('duplicate versions')
    unknown = [version for version in versions if version not in listed]
    if unknown:
        parser.error('unknown version: ' + ', '.join(unknown))
    asset = host_asset()
    report = (args.report or Path(tempfile.mkdtemp(prefix='hgm-', dir=TMP)) / 'matrix').resolve()
    logs = report.with_suffix('.logs')
    logs.mkdir(parents=True, exist_ok=False)
    env = safe_environment()
    executables, threads = build_once(env, logs / 'build')
    cache = args.cache.expanduser().resolve()
    def run_release(version):
        directory = logs / version
        directory.mkdir()
        row = {'version': version, 'asset': asset, 'sha256': listed[version][asset], 'suites': {}, 'status': 'FAIL'}
        try:
            binary = fetch(version, asset, listed[version][asset], cache)
            row['binary'] = str(binary)
            run_env = dict(env, HG_TEST_HERDR_BINARY=str(binary), HG_TEST_THREADS_BINARY=str(threads),
                           PATH=str(binary.parent) + os.pathsep + env.get('PATH', '/usr/bin:/bin'))
            for name, expected in SUITES.items():
                row['suites'][name] = run_suite(executables[name], expected, run_env, directory / name, args.timeout,
                                                       {'e2e_private_herdr': 30, 'herdr_client': 5, 'threads_real': 3}[name], name)
            if all(result['status'] == 'PASS' for result in row['suites'].values()):
                row['status'] = 'PASS'
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
            row['error'] = str(error)
        (directory / 'result.json').write_text(json.dumps(row, indent=2) + '\n')
        print(f'herdr {version}: {row["status"]}', flush=True)
        return row
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
        results = list(pool.map(run_release, versions))
    head = subprocess.run(['git', 'rev-parse', 'HEAD'], cwd=ROOT, env=env,
                          capture_output=True, text=True, check=True).stdout.strip()
    payload = {'head': head, 'asset': asset, 'logs': str(logs), 'releases': results,
               'status': 'PASS' if all(row['status'] == 'PASS' for row in results) else 'FAIL',
               'expected_cases_per_release': sum(map(len, SUITES.values())),
               'threads_source': str((ROOT / 'third_party/herdr-threads').resolve()),
               'native_models': False}
    write_reports(report, payload)
    return int(payload['status'] != 'PASS')


def install_signal_handlers():
    signal.signal(signal.SIGINT, lambda *_: STOP.set())
    signal.signal(signal.SIGTERM, lambda *_: STOP.set())


if __name__ == '__main__':
    install_signal_handlers()
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f'herdr-release-smoke: {error}', file=sys.stderr)
        sys.exit(1)
