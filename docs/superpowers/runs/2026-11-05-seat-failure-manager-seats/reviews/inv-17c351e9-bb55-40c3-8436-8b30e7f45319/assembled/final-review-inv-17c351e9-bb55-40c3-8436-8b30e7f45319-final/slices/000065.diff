+fn point(fx: &Fx, seat_name: &str, manager: Option<&str>) {
+    use super::managers::reparent::testing::seat_request;
+    let m = manager.map(|m| seat_id(fx, m));
+    commit_request(fx, seat_request(&seat_id(fx, seat_name), m.as_ref()));
+}
