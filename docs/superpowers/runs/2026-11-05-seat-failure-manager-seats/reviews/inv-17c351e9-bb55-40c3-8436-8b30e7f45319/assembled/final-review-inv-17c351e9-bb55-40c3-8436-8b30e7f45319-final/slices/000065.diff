+fn set_manager(fx: &Fx, seat: &SeatId, manager: &SeatId) {
+    commit_request(
+        fx,
+        ChangeRequest {
+            kind: RequestKind::Bookkeeping,
+            args: json!({ "sub": "test_pointers", "seat": seat, "manager": manager }),
+            relied_on: vec![],
+            requester: Requester::default(),
+            supersedes: None,
+            confirmed: None,
+        },
+    );
+}
