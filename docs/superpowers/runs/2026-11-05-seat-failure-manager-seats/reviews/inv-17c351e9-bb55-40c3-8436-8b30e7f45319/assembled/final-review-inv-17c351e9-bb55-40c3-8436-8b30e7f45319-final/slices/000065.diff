+/// Dormant seats `names` in `ts`, with the first one made the node manager.
+fn dormant_seats(fx: &Fx, ts: &str, names: &[&str]) {
+    for n in names {
+        commit(fx, &format!("seat create {n} --teamspace {ts}"));
+    }
+}
