+fn sorted(
+    mut v: Vec<(String, AnyId, Option<SeatId>, Option<SeatId>)>,
+) -> Vec<(String, AnyId, Option<SeatId>, Option<SeatId>)> {
+    v.sort_by(|a, b| a.1.cmp(&b.1));
