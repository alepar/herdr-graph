+fn no_cycles(fx: &Fx) {
+    for (_, s) in layout::all_seats(&view(fx)).unwrap() {
+        crate::model::manager::manager_chain(&view(fx), &s.id)
+            .unwrap_or_else(|e| panic!("chain of {}: {e}", s.name));
+    }
+    assert_eq!(
+        crate::model::manager::would_create_cycle(
+            &view(fx),
+            &[],
+            &layout::all_seats(&view(fx))
+                .unwrap()
+                .into_iter()
+                .map(|(_, s)| s.id)
+                .collect::<Vec<_>>()
+        )
+        .unwrap(),
+        None
+    );
+}
