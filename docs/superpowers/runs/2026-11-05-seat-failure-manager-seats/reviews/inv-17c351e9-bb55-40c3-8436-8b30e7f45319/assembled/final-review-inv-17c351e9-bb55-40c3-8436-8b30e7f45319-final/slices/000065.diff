+fn commit_request(fx: &Fx, req: ChangeRequest) {
+    let op = crate::ports::writer::Writer::admit(&*fx.w, req).unwrap();
+    fx.w.drain().unwrap();
+    let row = fx.w.journal().get(&op).unwrap().unwrap();
+    assert_eq!(row.state, OpState::Committed, "{:?}", row.rejection);
+}
