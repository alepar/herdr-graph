+#[test]
+fn old_reply_without_fields_renders() {
+    let out = render_seat(&json!({ "resolution": { "status": "bound" } }));
+    assert!(out.contains("\nmanager: none assigned\n"), "{out}");
+    assert!(out.contains("\nnode manager: none assigned\n"), "{out}");
+}
