+/// Teamspace alpha with plain (unbound) seats `names`; the first is not special.
+fn plain_seats(fx: &Fx, names: &[&str]) {
+    plan_and_apply(fx, "teamspace create alpha");
+    for n in names {
+        plan_and_apply(
+            fx,
+            &format!("seat create {n} --teamspace alpha --harness shell"),
+        );
+    }
+}
+
+fn manager_of(fx: &Fx, seat_name: &str, manager: Option<&str>) {
+    let m = manager.map(|n| seat(fx, n).id.to_string());
+    bookkeeping(
+        fx,
+        "test_seat_manager",
+        json!({ "seat": seat(fx, seat_name).id, "manager": m }),
+    );
+}
+
+#[test]
+fn manager_line_forms() {
+    assert_eq!(manager_line(&[]), "manager: none assigned");
+    let n = |id: &str, name: &str| NamedId {
+        id: id.into(),
+        name: name.into(),
+    };
+    assert_eq!(
+        manager_line(&[n("st_1", "boss"), n("st_2", "nm")]),
+        "manager: boss (st_1) -> nm (st_2)"
+    );
+}
+
+#[tokio::test]
+async fn who_reports_manager_chain() {
+    let fx = fx();
+    plain_seats(&fx, &["boss", "mid", "low"]);
+    bookkeeping(
+        &fx,
+        "test_seat_manager",
+        json!({ "node_manager": seat(&fx, "boss").id }),
+    );
+    manager_of(&fx, "low", Some("mid"));
+    let (boss, mid, low) = (seat(&fx, "boss"), seat(&fx, "mid"), seat(&fx, "low"));
+    let reply = who(&view(&fx), low.id.as_str()).unwrap();
+    let names: Vec<_> = reply
+        .manager_chain
+        .iter()
+        .map(|n| n.name.as_str())
+        .collect();
+    assert_eq!(names, ["mid", "boss"]);
+    assert_eq!(
+        reply.render(),
+        format!("alpha/low\nmanager: mid ({}) -> boss ({})", mid.id, boss.id)
+    );
+    // The node manager itself has no manager above it.
+    assert_eq!(
+        who(&view(&fx), boss.id.as_str()).unwrap().render(),
+        "alpha/boss\nmanager: none assigned"
+    );
+}
+
+#[tokio::test]
+async fn who_unassigned_graph_says_none() {
+    let fx = fx();
+    plain_seats(&fx, &["low"]);
+    let reply = who(&view(&fx), seat(&fx, "low").id.as_str()).unwrap();
+    assert!(reply.manager_chain.is_empty());
+    assert_eq!(reply.render(), "alpha/low\nmanager: none assigned");
+    // An unbound reply stays one line.
+    assert_eq!(who(&view(&fx), "w9:p9").unwrap().render(), "unbound");
+}
+
+#[tokio::test]
+async fn who_cycle_is_integrity() {
+    let fx = fx();
+    plain_seats(&fx, &["a", "b"]);
+    manager_of(&fx, "a", Some("b"));
+    manager_of(&fx, "b", Some("a"));
+    let a = seat(&fx, "a");
+    assert!(matches!(
+        who(&view(&fx), a.id.as_str()),
+        Err(StoreError::Integrity { .. })
+    ));
+    let mut reg = Registry::default();
+    register_commands(&mut reg, fx.store.clone());
+    let h = reg.handler("who").unwrap();
+    let ctx = CommandCtx {
+        request_id: "r".into(),
+        caller: CallerInfo::default(),
+    };
+    let e = h.call(ctx, json!({ "target": a.id })).await.unwrap_err();
+    assert_eq!(e.code, crate::ipc::IpcErrorCode::Integrity, "{}", e.message);
+}
