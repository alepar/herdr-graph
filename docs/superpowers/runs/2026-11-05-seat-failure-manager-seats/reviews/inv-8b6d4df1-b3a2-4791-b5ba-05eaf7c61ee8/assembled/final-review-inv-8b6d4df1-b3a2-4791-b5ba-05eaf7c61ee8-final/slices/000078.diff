+    assert_eq!(seat(&fx, "report").manager, Some(foreman.clone()));
+    let acts = actions(&fx, ActionKind::ClosureCascade);
+    assert_eq!(acts.len(), 1);
+    assert_eq!(
+        recorded(&acts[0]),
+        vec![Rewrite {
+            holder: seat(&fx, "report").id.to_any(),
+            field: "manager".into(),
+            old: bench,
+            new: Some(foreman),
