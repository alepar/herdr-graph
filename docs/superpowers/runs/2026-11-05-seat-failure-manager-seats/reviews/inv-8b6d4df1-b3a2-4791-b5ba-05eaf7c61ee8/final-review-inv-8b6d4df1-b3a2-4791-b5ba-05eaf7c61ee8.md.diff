++    {
++        return Err(PlanError::Invalid(format!(
++            "node manager {name} has no manager (it is the root)"
++        )));
++    }
++    if to == from {
++        return Err(PlanError::Invalid(format!(
++            "{name} already has that manager; nothing to change"
++        )));
++    }
++    let (edit, effect) = match &subject {
++        Subject::Seat(id) => (
