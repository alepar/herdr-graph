+fn seat_pointer(
+    fx: &Fx,
+    holder: &str,
+    from: &str,
+    to: &str,
+) -> (String, AnyId, Option<SeatId>, Option<SeatId>) {
+    (
+        "seat.manager".into(),
+        seat_id(fx, holder).to_any(),
+        Some(seat_id(fx, from)),
+        Some(seat_id(fx, to)),
+    )
