++    let e = default_manager_effect(&ts, None, Some(&a));
++    assert_eq!(e.kind, TEAMSPACE_DEFAULT_MANAGER);
++    assert_eq!(e.object, ts.to_any());
++    assert_eq!(e.detail, json!({ "from": null, "to": a }));
