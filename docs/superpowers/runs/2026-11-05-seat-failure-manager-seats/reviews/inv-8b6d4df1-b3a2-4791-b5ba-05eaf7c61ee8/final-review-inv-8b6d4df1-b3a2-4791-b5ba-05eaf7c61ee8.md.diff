index 0000000..00396e0
--- /dev/null
+++ b/src/plan/managers/edit.rs
@@ -0,0 +1,245 @@
+//! `ManagerEdit` kind (hg-k4l.13): sets or clears a seat's `manager` or a teamspace's `default_manager`.
+//! `plan manager set <seat|teamspace> <manager-seat>` / `plan manager clear <seat|teamspace>`.
+use super::{apply_pointer_effects, default_manager_effect, graph_relied_on, seat_manager_effect};
+use crate::daemon::registry::CallerInfo;
+use crate::model::change::RequestKind;
+use crate::model::common::Lifecycle;
+use crate::model::manager::{PointerEdit, Pointers, would_create_cycle};
+use crate::model::{SeatId, TeamspaceId};
+use crate::plan::core_kinds::{mm, parse_args, read_seat, read_ts, rev_of};
+use crate::plan::grammar::{self, Scope, positionals};
+use crate::plan::kind::{KindRegistry, OrgKind, PlanBody, PlanCx, PlanError};
+use crate::plan::types::{Plan, PlanEffect, Reserved};
+use crate::store::layout;
+use crate::store::tree::TreeRead;
+use crate::writer::{Applied, MutationCx, MutationError};
+use serde::{Deserialize, Serialize};
+use serde_json::json;
+use std::sync::Arc;
+
+const USAGE: &str = "manager set <seat|teamspace> <manager-seat> | manager clear <seat|teamspace>";
+
+pub(super) fn register(reg: &mut KindRegistry) {
+    reg.register(Arc::new(ManagerEdit));
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+struct EditArgs {
+    /// `set` or `clear`.
+    action: String,
+    subject: String,
+    #[serde(default)]
+    manager: Option<String>,
+}
+
+enum Subject {
+    Seat(SeatId),
+    Teamspace(TeamspaceId),
+}
+
+/// A `st_` / `ts_` id as is; a name as a live seat, else a live teamspace; both is a usage error.
+fn resolve_subject(tree: &dyn TreeRead, s: &str) -> Result<Subject, PlanError> {
+    if let Ok(id) = SeatId::parse(s) {
+        return Ok(Subject::Seat(id));
+    }
+    if let Ok(id) = TeamspaceId::parse(s) {
+        return Ok(Subject::Teamspace(id));
+    }
+    let seat = grammar::resolve_seat(tree, s, Scope::Live);
+    let ts = grammar::resolve_teamspace(tree, s, Scope::Live);
+    match (seat, ts) {
+        (Ok(_), Ok(_)) => Err(PlanError::Usage(format!(
+            "{s} names both a seat and a teamspace; use the id"
+        ))),
+        (Ok(id), Err(_)) => Ok(Subject::Seat(id)),
+        (Err(_), Ok(id)) => Ok(Subject::Teamspace(id)),
+        (Err(e @ PlanError::Store(_)), _) | (_, Err(e @ PlanError::Store(_))) => Err(e),
+        (Err(a), Err(b)) => Err([a, b]
+            .into_iter()
+            .find(|e| e.to_string().contains("ambiguous"))
+            .unwrap_or_else(|| PlanError::Invalid(format!("no seat or teamspace named {s:?}")))),
+    }
+}
+
+/// The checked edit: what it writes and what the plan relies on.
+struct Checked {
+    effect: PlanEffect,
+    relied_on: Vec<crate::model::change::ReliedOn>,
+    summary: String,
+}
+
+fn validate(tree: &dyn TreeRead, a: &EditArgs) -> Result<Checked, PlanError> {
+    let set = match a.action.as_str() {
+        "set" => true,
+        "clear" => false,
+        _ => return Err(PlanError::Usage(USAGE.into())),
+    };
+    let subject = resolve_subject(tree, &a.subject)?;
+    // (subject name, subject rev, current pointer, seats whose chains the edit can change)
+    let (name, rev, from, members, object) = match &subject {
+        Subject::Seat(id) => {
+            let f = read_seat(tree, id)?;
+            if f.rec.lifecycle == Lifecycle::Retired {
+                return Err(PlanError::Invalid(format!(
+                    "seat {} is retired; use `seat resurrect`",
+                    f.rec.name
+                )));
+            }
+            (
+                f.rec.name.clone(),
+                f.rec.rev,
+                f.rec.manager.clone(),
+                vec![id.clone()],
+                id.to_any(),
+            )
+        }
+        Subject::Teamspace(id) => {
+            let t = read_ts(tree, id)?.rec;
+            if t.lifecycle == Lifecycle::Retired {
+                return Err(PlanError::Invalid(format!(
+                    "teamspace {} is retired; use `teamspace resurrect`",
+                    t.name
+                )));
+            }
+            let members = layout::all_seats(tree)?
+                .into_iter()
+                .filter(|(_, s)| s.teamspace == *id && s.lifecycle != Lifecycle::Retired)
+                .map(|(_, s)| s.id)
+                .collect();
+            (
+                t.name.clone(),
+                t.rev,
+                t.default_manager.clone(),
+                members,
+                id.to_any(),
+            )
+        }
+    };
+    let mut relied_on = vec![rev_of(object, rev)];
+    let mut manager_name = None;
+    let to = if set {
+        let m_ref = a
+            .manager
+            .as_deref()
+            .ok_or_else(|| PlanError::Usage(USAGE.into()))?;
+        let m_id = grammar::resolve_seat(tree, m_ref, Scope::Live)?;
+        let m = read_seat(tree, &m_id)?.rec;
+        if m.lifecycle == Lifecycle::Retired {
+            return Err(PlanError::Invalid(format!(
+                "manager seat {} is retired; pick a live seat",
+                m.name
+            )));
+        }
+        relied_on.push(rev_of(m.id.clone(), m.rev));
+        manager_name = Some(m.name);
+        Some(m.id)
+    } else {
+        None
+    };
+    if let Subject::Seat(id) = &subject
+        && crate::model::manager::live_node_manager(tree)?.as_ref() == Some(id)
+    {
+        return Err(PlanError::Invalid(format!(
+            "node manager {name} has no manager (it is the root)"
+        )));
+    }
+    if to == from {
+        return Err(PlanError::Invalid(format!(
+            "{name} already has that manager; nothing to change"
+        )));
+    }
+    let (edit, effect) = match &subject {
+        Subject::Seat(id) => (
+            PointerEdit::SeatManager {
+                seat: id.clone(),
+                manager: to.clone(),
+            },
+            seat_manager_effect(id, from.as_ref(), to.as_ref()),
+        ),
+        Subject::Teamspace(id) => (
+            PointerEdit::DefaultManager {
+                teamspace: id.clone(),
+                manager: to.clone(),
+            },
+            default_manager_effect(id, from.as_ref(), to.as_ref()),
+        ),
+    };
+    if let Some(cycle) = would_create_cycle(tree, &[edit], &members)? {
+        let p = Pointers::load(tree)?;
+        let names: Vec<String> = cycle
+            .iter()
+            .map(|id| p.name(id).map_or_else(|| id.to_string(), str::to_owned))
+            .collect();
+        return Err(PlanError::Invalid(format!(
+            "this change would make a manager cycle: {}",
+            names.join(" -> ")
+        )));
+    }
+    relied_on.push(graph_relied_on(tree)?);
+    let summary = match manager_name {
+        Some(m) => format!("set manager of {name} to {m}"),
+        None => format!("clear manager of {name}"),
+    };
+    Ok(Checked {
+        effect,
+        relied_on,
+        summary,
+    })
+}
+
+struct ManagerEdit;
+impl OrgKind for ManagerEdit {
+    fn kind(&self) -> RequestKind {
+        RequestKind::ManagerEdit
+    }
+    /// Registered like `undo`: the noun alone, so `resolve` passes `set|clear` and its words to `parse`.
+    fn verbs(&self) -> &'static [(&'static str, &'static str)] {
+        &[("manager", "")]
+    }
+    fn parse(&self, words: &[String], _: &CallerInfo) -> Result<serde_json::Value, PlanError> {
+        let pos = positionals(words);
+        let usage = || PlanError::Usage(USAGE.into());
+        let args = match pos.as_slice() {
+            [a, s, m] if a == "set" => EditArgs {
+                action: "set".into(),
+                subject: s.clone(),
+                manager: Some(m.clone()),
+            },
+            [a, s] if a == "clear" => EditArgs {
+                action: "clear".into(),
+                subject: s.clone(),
+                manager: None,
+            },
+            _ => return Err(usage()),
+        };
+        Ok(json!({ "action": args.action, "subject": args.subject, "manager": args.manager }))
+    }
+    fn plan(
+        &self,
+        cx: &PlanCx<'_>,
+        args: &serde_json::Value,
+        _: &mut Reserved,
+    ) -> Result<PlanBody, PlanError> {
+        let c = validate(cx.tree, &parse_args(args)?)?;
+        Ok(PlanBody {
+            effects: vec![c.effect],
+            relied_on: c.relied_on,
+            warnings: vec![],
+            repair_required: None,
+            summary: c.summary,
+        })
+    }
+    fn mutate(
+        &self,
+        cx: &mut MutationCx<'_>,
+        args: &serde_json::Value,
+        plan: &Plan,
+    ) -> Result<Applied, MutationError> {
+        let c = validate(&cx.tree, &parse_args(args).map_err(mm)?).map_err(mm)?;
+        apply_pointer_effects(&mut cx.tree, &plan.effects)?;
+        Ok(Applied {
+            summary: c.summary,
+            action: None,
+        })
+    }
+}
diff --git a/src/plan/managers/first_seat.rs b/src/plan/managers/first_seat.rs
new file mode 100644
index 0000000..4561123
--- /dev/null
+++ b/src/plan/managers/first_seat.rs
@@ -0,0 +1,147 @@
+//! First seat on the node becomes the node manager (spec §4.8, B10, S1). Every seat-creating or
+//! -resurrecting plan path calls `assignment` with the first seat it creates or resurrects, and its `mutate`
+//! calls `apply_assignment`; no path decides this itself. Paths: SeatCreate (hg-k4l.23), ApplicationApply and
+//! TemplateEdit additions (hg-k4l.24), SeatResurrect, TeamspaceResurrect and undo restore (hg-k4l.25).
+
+use super::{
+    GRAPH_NODE_MANAGER, graph_blob, graph_relied_on, node_manager_effect, set_node_manager,
+};
+use crate::model::SeatId;
+use crate::model::change::ReliedOn;
+use crate::model::common::Lifecycle;
+use crate::plan::types::PlanEffect;
+use crate::ports::store::StoreError;
+use crate::store::tree::TreeRead;
+use crate::store::{Overlay, layout};
+use crate::writer::MutationError;
+
+/// The graph qualifies: graph.toml `node_manager_seat` is unset (None; a dangling id counts as set and gets the
+/// §4.10 warning instead) and no seat is non-retired.
+pub fn qualifies(tree: &dyn TreeRead) -> Result<bool, StoreError> {
+    if layout::read_graph(tree)?.node_manager_seat.is_some() {
+        return Ok(false);
+    }
+    Ok(layout::all_seats(tree)?
+        .iter()
+        .all(|(_, s)| s.lifecycle == Lifecycle::Retired))
+}
+
+/// Plan side. When `first` is Some and the graph qualifies: the `graph.node_manager_seat` effect (from None to
+/// `first`, built with `node_manager_effect` and `graph_blob`) and its blob relied_on entry (`graph_relied_on`).
+/// The caller must make that seat (and its teamspace) Active in the same plan (C3).
+pub fn assignment(
+    tree: &dyn TreeRead,
+    first: Option<&SeatId>,
+) -> Result<Option<(PlanEffect, ReliedOn)>, StoreError> {
+    let Some(first) = first else { return Ok(None) };
+    if !qualifies(tree)? {
+        return Ok(None);
+    }
+    let effect = node_manager_effect(
+        &layout::graph_id(tree)?,
+        None,
+        Some(first),
+        &graph_blob(tree)?,
+    );
+    Ok(Some((effect, graph_relied_on(tree)?)))
+}
+
+/// Apply side: write the plan's `graph.node_manager_seat` effect, if it has one, with `set_node_manager` (the
+/// confirmed plan equals the recompute, so the listed effect is authoritative). No-op when absent.
+pub fn apply_assignment(
+    tree: &mut Overlay<'_>,
+    effects: &[PlanEffect],
+) -> Result<(), MutationError> {
+    let Some(e) = effects.iter().find(|e| e.kind == GRAPH_NODE_MANAGER) else {
+        return Ok(());
+    };
+    let to: Option<SeatId> = e
+        .detail
+        .get("to")
+        .cloned()
+        .map(serde_json::from_value)
+        .transpose()
+        .map_err(|err| MutationError::Bug(format!("{} {}: malformed to: {err}", e.kind, e.object)))?
+        .flatten();
+    set_node_manager(tree, to)?;
+    Ok(())
+}
+
+/// The plan assigns the role to `seat`: the path must create/resurrect it Active.
+pub fn forces_active(effects: &[PlanEffect], seat: &SeatId) -> bool {
+    effects.iter().any(|e| {
+        e.kind == GRAPH_NODE_MANAGER
+            && e.detail
+                .get("to")
+                .is_some_and(|to| to.as_str() == Some(seat.as_str()))
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::ports::store::Store;
+    use crate::store::GitStore;
+    use crate::store::init::init_instance;
+
+    fn open(tmp: &tempfile::TempDir) -> GitStore {
+        let root = tmp.path().join("inst");
+        init_instance(&root).unwrap();
+        GitStore::open(&root).unwrap()
+    }
+
+    #[test]
+    fn qualifies_on_an_empty_graph_and_assignment_lists_the_effect() {
+        let tmp = tempfile::tempdir().unwrap();
+        let store = open(&tmp);
+        let view = store.at(&store.head().unwrap());
+        assert!(qualifies(&view).unwrap());
+        let first = SeatId::new();
+        let (effect, relied) = assignment(&view, Some(&first)).unwrap().unwrap();
+        assert_eq!(effect.kind, GRAPH_NODE_MANAGER);
+        assert_eq!(effect.detail["from"], serde_json::Value::Null);
+        assert_eq!(effect.detail["to"], serde_json::json!(first));
+        assert_eq!(relied, graph_relied_on(&view).unwrap());
+        assert!(assignment(&view, None).unwrap().is_none());
+    }
+
+    #[test]
+    fn does_not_qualify_when_the_field_is_set_even_dangling() {
+        let tmp = tempfile::tempdir().unwrap();
+        let store = open(&tmp);
+        let head = store.head().unwrap();
+        let mut ov = Overlay::new(&store, head);
+        set_node_manager(&mut ov, Some(SeatId::new())).unwrap();
+        assert!(!qualifies(&ov).unwrap());
+        assert!(assignment(&ov, Some(&SeatId::new())).unwrap().is_none());
+    }
+
+    #[test]
+    fn forces_active_only_for_the_named_seat() {
+        let tmp = tempfile::tempdir().unwrap();
+        let store = open(&tmp);
+        let view = store.at(&store.head().unwrap());
+        let (first, other) = (SeatId::new(), SeatId::new());
+        let (effect, _) = assignment(&view, Some(&first)).unwrap().unwrap();
+        assert!(forces_active(std::slice::from_ref(&effect), &first));
+        assert!(!forces_active(std::slice::from_ref(&effect), &other));
+        assert!(!forces_active(&[], &first));
+    }
+
+    #[test]
+    fn apply_assignment_writes_the_listed_effect_and_is_a_noop_without_one() {
+        let tmp = tempfile::tempdir().unwrap();
+        let store = open(&tmp);
+        let head = store.head().unwrap();
+        let first = SeatId::new();
+        let mut ov = Overlay::new(&store, head);
+        apply_assignment(&mut ov, &[]).unwrap();
+        assert_eq!(layout::read_graph(&ov).unwrap().node_manager_seat, None);
+        let (effect, _) = assignment(&ov, Some(&first)).unwrap().unwrap();
+        apply_assignment(&mut ov, &[effect]).unwrap();
+        assert_eq!(
+            layout::read_graph(&ov).unwrap().node_manager_seat,
+            Some(first)
+        );
+    }
+}
diff --git a/src/plan/managers/mod.rs b/src/plan/managers/mod.rs
new file mode 100644
index 0000000..f913051
--- /dev/null
+++ b/src/plan/managers/mod.rs
@@ -0,0 +1,286 @@
+//! Manager-pointer writes and the node-manager policy for plans (spec §4.7–§4.11; Key abstractions plan::managers).
+//!
+//! Owns every write of manager pointers — reparenting on retirement (`reparent`), the node-manager move
+//! (`node_manager`), manager edits (`edit`), first-seat assignment (`first_seat`) and the graph.toml blob write —
+//! and the two plan-admission guards `make_plan` runs through `admit`: the node-manager retirement guard
+//! (`retire`) and the manager-chain cycle guard (`cycle_guard`). New pointer-rewriting rules go here.
+//! Kinds and retirement routes never rewrite pointers or check for node-manager retirement themselves.
+//! Must not: decide who someone's manager is (model::manager does), parse CLI words beyond its own kinds,
+//! or touch runtime or observation (observe::classify does).
+//! Errors: refusals, cycles and "unchanged" are `PlanError::Invalid`; store failures, integrity included,
+//! pass through as `PlanError::Store`.
+pub mod cycle_guard;
+pub mod edit;
+pub mod first_seat;
+pub mod node_manager;
+pub mod reparent;
+pub mod retire;
+
+use super::kind::{KindRegistry, PlanError};
+use super::types::PlanEffect;
+use crate::model::change::{ReliedOn, Version};
+use crate::model::common::BlobHash;
+use crate::model::graph::GraphRecord;
+use crate::model::seat::SeatRecord;
+use crate::model::teamspace::TeamspaceRecord;
+use crate::model::{GraphId, SeatId, TeamspaceId};
+use crate::ports::store::{StoreError, unresolved};
+use crate::store::record::to_toml_bytes;
+use crate::store::tree::TreeRead;
+use crate::store::{Overlay, layout};
+use crate::writer::MutationError;
+use serde_json::json;
+
+/// The one spelling of the node-manager command in messages (warning, refusals).
+pub const NODE_MANAGER_SET_USAGE: &str = "herdr-graph plan node-manager set <seat>";
+/// Plan effect kinds for pointer writes.
+pub const SEAT_MANAGER: &str = "seat.manager";
+pub const TEAMSPACE_DEFAULT_MANAGER: &str = "teamspace.default_manager";
+pub const GRAPH_NODE_MANAGER: &str = "graph.node_manager_seat";
+
+/// Registers ManagerEdit (`edit`) and NodeManagerSet (`node_manager`); called from `register_core_kinds`.
+pub fn register_kinds(reg: &mut KindRegistry) {
+    edit::register(reg);
+    node_manager::register(reg);
+}
+
+/// Plan admission, run once by `make_plan` over every plan's effects (the single admission point; it also covers
+/// the replan in plan/apply.rs and undo).
+pub fn admit(tree: &dyn TreeRead, effects: &[PlanEffect]) -> Result<(), PlanError> {
+    retire::refuse_node_manager_retirement(tree, effects)?;
+    cycle_guard::refuse_cyclic_chains(tree, effects)
+}
+
+/// Git blob sha of graph.toml at `tree` (same hashing as plan/instructions.rs); graph.toml has no `rev`.
+pub fn graph_blob(tree: &dyn TreeRead) -> Result<BlobHash, StoreError> {
+    let path = layout::graph_toml();
+    let bytes = tree.read_file(&path)?.ok_or_else(|| StoreError::Corrupt {
+        path: path.as_str().into(),
+        reason: "missing".into(),
+    })?;
+    git2::Oid::hash_object(git2::ObjectType::Blob, &bytes)
+        .map(|o| BlobHash(o.to_string()))
+        .map_err(|e| StoreError::Git(e.to_string()))
+}
+
+/// `ReliedOn { object: layout::graph_id(tree)?.to_any(), version: Version::Blob(graph_blob(tree)?) }`.
+pub fn graph_relied_on(tree: &dyn TreeRead) -> Result<ReliedOn, StoreError> {
+    Ok(ReliedOn {
+        object: layout::graph_id(tree)?.to_any(),
+        version: Version::Blob(graph_blob(tree)?),
+    })
+}
+
+/// Serialize `g` and `put_file(layout::graph_toml(), ..)` on the writer overlay.
+pub fn write_graph(tree: &mut Overlay<'_>, g: &GraphRecord) -> Result<(), StoreError> {
+    let path = layout::graph_toml();
+    let bytes = to_toml_bytes(g).map_err(|e| match e {
+        StoreError::Corrupt { reason, .. } => StoreError::Corrupt {
+            path: path.as_str().into(),
+            reason,
+        },
+        other => other,
+    })?;
+    tree.put_file(path, bytes);
+    Ok(())
+}
+
+fn pointer_effect(
+    kind: &str,
+    object: crate::model::AnyId,
+    from: Option<&SeatId>,
+    to: Option<&SeatId>,
+) -> PlanEffect {
+    PlanEffect::new(kind, object, json!({ "from": from, "to": to }))
+}
+
+/// `seat.manager <seat> from=<old|null> to=<new|null>`.
+pub fn seat_manager_effect(
+    seat: &SeatId,
+    from: Option<&SeatId>,
+    to: Option<&SeatId>,
+) -> PlanEffect {
+    pointer_effect(SEAT_MANAGER, seat.to_any(), from, to)
+}
+
+/// `teamspace.default_manager <ts> from=.. to=..`.
+pub fn default_manager_effect(
+    ts: &TeamspaceId,
+    from: Option<&SeatId>,
+    to: Option<&SeatId>,
+) -> PlanEffect {
+    pointer_effect(TEAMSPACE_DEFAULT_MANAGER, ts.to_any(), from, to)
+}
+
+/// `graph.node_manager_seat <gr_> from=.. to=.. graph_sha=<blob at plan time>`: graph_sha makes a recompute
+/// against a changed graph.toml differ, so the apply is rejected stale_plan (org plans admit with empty relied_on).
+pub fn node_manager_effect(
+    graph: &GraphId,
+    from: Option<&SeatId>,
+    to: Option<&SeatId>,
+    graph_sha: &BlobHash,
+) -> PlanEffect {
+    PlanEffect::new(
+        GRAPH_NODE_MANAGER,
+        graph.to_any(),
+        json!({ "from": from, "to": to, "graph_sha": graph_sha.0 }),
+    )
+}
+
+/// Record writes on the overlay; each returns the previous value.
+pub fn set_seat_manager(
+    tree: &mut Overlay<'_>,
+    seat: &SeatId,
+    to: Option<SeatId>,
+) -> Result<Option<SeatId>, StoreError> {
+    let loc = tree
+        .locate(&seat.to_any())?
+        .ok_or_else(|| unresolved(seat, "seat", seat))?;
+    let mut rec: SeatRecord = tree
+        .read_record(&loc.record_path)?
+        .ok_or_else(|| unresolved(seat, "seat", seat))?;
+    let old = std::mem::replace(&mut rec.manager, to);
+    tree.put_record(loc.record_path, &mut rec)?;
+    Ok(old)
+}
+
+pub fn set_default_manager(
+    tree: &mut Overlay<'_>,
+    ts: &TeamspaceId,
+    to: Option<SeatId>,
+) -> Result<Option<SeatId>, StoreError> {
+    let loc = tree
+        .locate(&ts.to_any())?
+        .ok_or_else(|| unresolved(ts, "teamspace", ts))?;
+    let mut rec: TeamspaceRecord = tree
+        .read_record(&loc.record_path)?
+        .ok_or_else(|| unresolved(ts, "teamspace", ts))?;
+    let old = std::mem::replace(&mut rec.default_manager, to);
+    tree.put_record(loc.record_path, &mut rec)?;
+    Ok(old)
+}
+
+pub fn set_node_manager(
+    tree: &mut Overlay<'_>,
+    to: Option<SeatId>,
+) -> Result<Option<SeatId>, StoreError> {
+    let mut g = layout::read_graph(tree)?;
+    let old = std::mem::replace(&mut g.node_manager_seat, to);
+    write_graph(tree, &g)?;
+    Ok(old)
+}
+
+/// Apply the listed pointer effects of a confirmed plan (the three kinds above), in plan order. For kinds whose
+/// pointer changes are exactly their listed effects (ManagerEdit, NodeManagerSet).
+pub fn apply_pointer_effects(
+    tree: &mut Overlay<'_>,
+    effects: &[PlanEffect],
+) -> Result<(), MutationError> {
+    for e in effects {
+        if !matches!(
+            e.kind.as_str(),
+            SEAT_MANAGER | TEAMSPACE_DEFAULT_MANAGER | GRAPH_NODE_MANAGER
+        ) {
+            continue;
+        }
+        let to: Option<SeatId> = e
+            .detail
+            .get("to")
+            .cloned()
+            .map(serde_json::from_value)
+            .transpose()
+            .map_err(|err| {
+                MutationError::Bug(format!("{} {}: malformed to: {err}", e.kind, e.object))
+            })?
+            .flatten();
+        let bug =
+            |err: crate::model::ids::IdError| MutationError::Bug(format!("{}: {err}", e.kind));
+        match e.kind.as_str() {
+            SEAT_MANAGER => {
+                set_seat_manager(tree, &SeatId::try_from(e.object.clone()).map_err(bug)?, to)?;
+            }
+            TEAMSPACE_DEFAULT_MANAGER => {
+                set_default_manager(
+                    tree,
+                    &TeamspaceId::try_from(e.object.clone()).map_err(bug)?,
+                    to,
+                )?;
+            }
+            _ => {
+                set_node_manager(tree, to)?;
+            }
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests;
+
+#[cfg(test)]
+pub(crate) mod testing {
+    use crate::model::SeatId;
+    use crate::model::change::{ChangeRequest, RequestKind, Requester};
+    use crate::writer::{Applied, Mutation, MutationCx, MutationError};
+    use serde_json::json;
+
+    /// Registry key of `SetNodeManager`; fixtures that need it add one `reg.register(KEY, Arc::new(SetNodeManager))`.
+    pub const SET_NODE_MANAGER_KEY: &str = "bookkeeping.test_node_manager";
+
+    /// Test-only mutation: args `{"sub": "test_node_manager", "seat": "<st>"|null}` → graph.toml node_manager_seat.
+    pub struct SetNodeManager;
+    impl Mutation for SetNodeManager {
+        fn apply(&self, cx: &mut MutationCx<'_>) -> Result<Applied, MutationError> {
+            let seat: Option<SeatId> = match cx.request.args["seat"].as_str() {
+                Some(s) => Some(s.parse().map_err(|e| {
+                    MutationError::Bug(format!("test_node_manager seat {s:?}: {e}"))
+                })?),
+                None => None,
+            };
+            super::set_node_manager(&mut cx.tree, seat)?;
+            Ok(Applied {
+                summary: "set node manager".into(),
+                action: None,
+            })
+        }
+    }
+
+    /// The ChangeRequest that sets (or clears with None) the node manager through `SetNodeManager`.
+    pub fn request(seat: Option<&SeatId>) -> ChangeRequest {
+        ChangeRequest {
+            kind: RequestKind::Bookkeeping,
+            args: json!({ "sub": "test_node_manager", "seat": seat }),
+            relied_on: vec![],
+            requester: Requester::default(),
+            supersedes: None,
+            confirmed: None,
+        }
+    }
+
+    /// Commit (git2, before any writer opens `root`, same pattern as `install_examples`) a graph.toml whose
+    /// node_manager_seat names a seat that does not exist. First-seat assignment never fires (the field is set) and
+    /// `live_node_manager` is None, so fixtures for unrelated behaviour keep their meaning.
+    pub fn opt_out(root: &std::path::Path) {
+        let path = root.join("graph.toml");
+        let mut g: crate::model::graph::GraphRecord =
+            toml::from_str(&std::fs::read_to_string(&path).unwrap()).unwrap();
+        g.node_manager_seat = Some(SeatId::new());
+        std::fs::write(&path, toml::to_string(&g).unwrap()).unwrap();
+        let repo = git2::Repository::open(root).unwrap();
+        let mut index = repo.index().unwrap();
+        index.add_path(std::path::Path::new("graph.toml")).unwrap();
+        index.write().unwrap();
+        let tree = repo.find_tree(index.write_tree().unwrap()).unwrap();
+        let parent = repo.head().unwrap().peel_to_commit().unwrap();
+        let sig = crate::store::git::graph_signature().unwrap();
+        repo.commit(
+            Some("refs/heads/main"),
+            &sig,
+            &sig,
+            "test: node manager opt-out",
+            &tree,
+            &[&parent],
+        )
+        .unwrap();
+    }
+}
diff --git a/src/plan/managers/node_manager.rs b/src/plan/managers/node_manager.rs
new file mode 100644
index 0000000..bc12218
--- /dev/null
+++ b/src/plan/managers/node_manager.rs
@@ -0,0 +1,193 @@
+//! `NodeManagerSet` kind (hg-k4l.6): `node-manager set <seat>` assigns the node-manager role, or moves it from
+//! the current holder, rewriting every pointer that named the old one (spec §4.7, second bullet).
+use super::{
+    apply_pointer_effects, default_manager_effect, graph_blob, graph_relied_on,
+    node_manager_effect, seat_manager_effect,
+};
+use crate::daemon::registry::CallerInfo;
+use crate::model::change::{ReliedOn, RequestKind, Version};
+use crate::model::common::Lifecycle;
+use crate::model::manager::Pointers;
+use crate::model::{AnyId, SeatId};
+use crate::plan::core_kinds::{SeatActivate, mm, parse_args, read_seat};
+use crate::plan::grammar::{self, Scope, positional};
+use crate::plan::kind::{KindRegistry, OrgKind, PlanBody, PlanCx, PlanError};
+use crate::plan::types::{Plan, PlanEffect, Reserved};
+use crate::store::layout;
+use crate::writer::{Applied, MutationCx, MutationError};
+use serde::Deserialize;
+use serde_json::json;
+use std::sync::Arc;
+
+pub(super) fn register(reg: &mut KindRegistry) {
+    reg.register(Arc::new(NodeManagerSet));
+}
+
+#[derive(Deserialize)]
+struct Args {
+    seat: String,
+}
+
+struct NodeManagerSet;
+
+fn activate_args(target: &SeatId) -> serde_json::Value {
+    json!({ "seat": target.to_string() })
+}
+
+fn rev(object: impl Into<AnyId>, rev: u64) -> ReliedOn {
+    ReliedOn {
+        object: object.into(),
+        version: Version::Rev(rev),
+    }
+}
+
+impl OrgKind for NodeManagerSet {
+    fn kind(&self) -> RequestKind {
+        RequestKind::NodeManagerSet
+    }
+    fn verbs(&self) -> &'static [(&'static str, &'static str)] {
+        &[("node-manager", "set")]
+    }
+    fn parse(&self, words: &[String], _: &CallerInfo) -> Result<serde_json::Value, PlanError> {
+        let seat = positional(words, 0)
+            .ok_or_else(|| PlanError::Usage("node-manager set <seat>".into()))?;
+        Ok(json!({ "seat": seat }))
+    }
+    fn plan(
+        &self,
+        cx: &PlanCx<'_>,
+        args: &serde_json::Value,
+        reserved: &mut Reserved,
+    ) -> Result<PlanBody, PlanError> {
+        let a: Args = parse_args(args)?;
+        let tree = cx.tree;
+        let retired = |id: &SeatId| {
+            PlanError::Invalid(format!(
+                "seat {id} is retired; the node manager must be a live seat"
+            ))
+        };
+        let target = match grammar::resolve_seat(tree, &a.seat, Scope::Live) {
+            Ok(id) => id,
+            Err(e) => {
+                return Err(match grammar::resolve_seat(tree, &a.seat, Scope::Retired) {
+                    Ok(id) => retired(&id),
+                    Err(_) => e,
+                });
+            }
+        };
+        let t = read_seat(tree, &target)?;
+        if t.rec.lifecycle == Lifecycle::Retired {
+            return Err(retired(&target));
+        }
+        let pointers = Pointers::load(tree)?;
+        let recorded = pointers.node_manager_seat.clone();
+        if pointers.live_node_manager().as_ref() == Some(&target) {
+            return Err(PlanError::Invalid(format!(
+                "seat {} ({target}) is already the node manager; nothing to change",
+                t.rec.name
+            )));
+        }
+
+        // C3: the node manager must be reachable, so the seat and its teamspace end up Active.
+        let mut effects = Vec::new();
+        let mut relied_on = Vec::new();
+        match t.rec.lifecycle {
+            Lifecycle::Dormant => {
+                let act = SeatActivate.plan(cx, &activate_args(&target), reserved)?;
+                effects.extend(act.effects);
+                relied_on.extend(act.relied_on);
+            }
+            _ if t.ts.rec.lifecycle != Lifecycle::Active => {
+                return Err(PlanError::Invalid(format!(
+                    "seat {} is active but its teamspace {} is not; activate the teamspace first",
+                    t.rec.name, t.ts.rec.name
+                )));
+            }
+            _ => {}
+        }
+        relied_on.push(rev(target.clone(), t.rec.rev));
+        relied_on.push(graph_relied_on(tree)?);
+
+        effects.push(node_manager_effect(
+            &layout::graph_id(tree)?,
+            recorded.as_ref(),
+            Some(&target),
+            &graph_blob(tree)?,
+        ));
+
+        let mut rewritten = |effect: PlanEffect, object: AnyId, record_rev: u64| {
+            effects.push(effect);
+            relied_on.push(rev(object, record_rev));
+        };
+        if let Some(old) = &recorded {
+            for (_, s) in layout::all_seats(tree)? {
+                if s.lifecycle == Lifecycle::Retired || s.id == target {
+                    continue;
+                }
+                if s.manager.as_ref() == Some(old) {
+                    rewritten(
+                        seat_manager_effect(&s.id, Some(old), Some(&target)),
+                        s.id.to_any(),
+                        s.rev,
+                    );
+                } else if &s.id == old && s.manager.as_ref() != Some(&target) {
+                    // The live old node manager reports to the new one.
+                    rewritten(
+                        seat_manager_effect(&s.id, s.manager.as_ref(), Some(&target)),
+                        s.id.to_any(),
+                        s.rev,
+                    );
+                }
+            }
+            for (_, ts) in layout::list_teamspaces(tree)? {
+                if ts.lifecycle != Lifecycle::Retired && ts.default_manager.as_ref() == Some(old) {
+                    rewritten(
+                        default_manager_effect(&ts.id, Some(old), Some(&target)),
+                        ts.id.to_any(),
+                        ts.rev,
+                    );
+                }
+            }
+        }
+        if let Some(m) = &t.rec.manager {
+            // The node manager has no manager; the target's rev is already relied on.
+            effects.push(seat_manager_effect(&target, Some(m), None));
+        }
+
+        let mut seen = Vec::new();
+        relied_on.retain(|r| {
+            let new = !seen.contains(&r.object);
+            seen.push(r.object.clone());
+            new
+        });
+        Ok(PlanBody {
+            effects,
+            relied_on,
+            warnings: vec![],
+            repair_required: None,
+            summary: format!("set node manager {}", t.rec.name),
+        })
+    }
+    fn mutate(
+        &self,
+        cx: &mut MutationCx<'_>,
+        args: &serde_json::Value,
+        plan: &Plan,
+    ) -> Result<Applied, MutationError> {
+        let a: Args = parse_args(args).map_err(mm)?;
+        let target = grammar::resolve_seat(&cx.tree, &a.seat, Scope::Live).map_err(mm)?;
+        if plan
+            .effects
+            .iter()
+            .any(|e| e.kind == "seat.activate" && e.object == target.to_any())
+        {
+            SeatActivate.mutate(cx, &activate_args(&target), plan)?;
+        }
+        apply_pointer_effects(&mut cx.tree, &plan.effects)?;
+        let name = read_seat(&cx.tree, &target).map_err(mm)?.rec.name;
+        Ok(Applied {
+            summary: format!("set node manager {name}"),
+            action: None,
+        })
+    }
+}
diff --git a/src/plan/managers/reparent.rs b/src/plan/managers/reparent.rs
new file mode 100644
index 0000000..ec314cc
--- /dev/null
+++ b/src/plan/managers/reparent.rs
@@ -0,0 +1,260 @@
+//! Reparenting on seat retirement (spec §4.11). Apply side (`reparent`, from do_retire_seat; hg-k4l.26) and plan
+//! preview (`reparent_effects`; hg-k4l.27). Retirement routes never rewrite pointers themselves.
+use super::{default_manager_effect, seat_manager_effect, set_default_manager, set_seat_manager};
+use crate::model::manager::Pointers;
+use crate::model::{AnyId, SeatId};
+use crate::plan::types::PlanEffect;
+use crate::ports::store::StoreError;
+use crate::store::tree::TreeRead;
+use crate::store::{Overlay, layout};
+use std::collections::BTreeSet;
+
+/// Compensation key of the rewrite list in every retirement action record.
+pub const REPARENTED_KEY: &str = "reparented";
+/// Compensation key of the observed-cascade fallback notes.
+pub const REPARENT_FALLBACK_KEY: &str = "reparent_fallback";
+
+/// One pointer a retirement rewrote: `field` is "manager" (holder = seat) or "default_manager" (holder = teamspace).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Rewrite {
+    pub holder: AnyId,
+    pub field: String,
+    pub old: SeatId,
+    pub new: Option<SeatId>,
+}
+
+impl Rewrite {
+    /// `{holder, field, old, new}`; `new` is omitted when None (the pointer was cleared).
+    pub fn to_toml(&self) -> toml::Value {
+        let mut t = toml::Table::new();
+        t.insert(
+            "holder".into(),
+            toml::Value::String(self.holder.to_string()),
+        );
+        t.insert("field".into(), toml::Value::String(self.field.clone()));
+        t.insert("old".into(), toml::Value::String(self.old.to_string()));
+        if let Some(new) = &self.new {
+            t.insert("new".into(), toml::Value::String(new.to_string()));
+        }
+        toml::Value::Table(t)
+    }
+
+    pub fn from_toml(v: &toml::Value) -> Option<Rewrite> {
+        let t = v.as_table()?;
+        let new = match t.get("new") {
+            Some(n) => Some(SeatId::parse(n.as_str()?).ok()?),
+            None => None,
+        };
+        Some(Rewrite {
+            holder: AnyId::parse(t.get("holder")?.as_str()?).ok()?,
+            field: t.get("field")?.as_str()?.to_string(),
+            old: SeatId::parse(t.get("old")?.as_str()?).ok()?,
+            new,
+        })
+    }
+}
+
+/// Apply side, from do_retire_seat before the seat is archived: rewrite every live seat whose explicit manager is
+/// `seat` and every non-retired teamspace whose default_manager is `seat` to `seat`'s nearest surviving manager.
+/// Seats retired earlier in the same mutation are already retired in the overlay, so they are transparent; seats
+/// retiring later in the same mutation are rewritten again when their turn comes, so final pointers match the preview.
+/// `lenient`: an integrity error computing the target falls back to `live_node_manager` (or None) and returns a note;
+/// not lenient, the error propagates (StoreError::Integrity → Fail::Data per hg-k4l.5).
+pub fn reparent(
+    tree: &mut Overlay<'_>,
+    seat: &SeatId,
+    lenient: bool,
+) -> Result<(Vec<Rewrite>, Option<String>), StoreError> {
+    let pointers = Pointers::load(&*tree)?;
+    let retiring = BTreeSet::from([seat.clone()]);
+    let (target, note) = match pointers.nearest_surviving_manager(seat, &retiring) {
+        Ok(t) => (t, None),
+        Err(e @ StoreError::Integrity { .. }) if lenient => {
+            let t = pointers.live_node_manager();
+            let note = format!(
+                "reparenting reports of {seat}: {e}; fell back to {}",
+                t.as_ref()
+                    .map_or("no manager".to_string(), |t| format!("node manager {t}"))
+            );
+            (t, Some(note))
+        }
+        Err(e) => return Err(e),
+    };
+    let mut seats: Vec<SeatId> = pointers
+        .seats
+        .iter()
+        .filter(|(_, p)| !p.retired && p.manager.as_ref() == Some(seat))
+        .map(|(id, _)| id.clone())
+        .collect();
+    seats.sort();
+    let mut teamspaces = Vec::new();
+    for (_, ts) in layout::list_teamspaces(&*tree)? {
+        if ts.lifecycle != crate::model::common::Lifecycle::Retired
+            && ts.default_manager.as_ref() == Some(seat)
+        {
+            teamspaces.push(ts.id);
+        }
+    }
+    teamspaces.sort();
+    let mut out = Vec::new();
+    for id in seats {
+        // The node manager has no manager; never point a seat at itself.
+        let new = target.clone().filter(|t| *t != id);
+        set_seat_manager(tree, &id, new.clone())?;
+        out.push(Rewrite {
+            holder: id.to_any(),
+            field: "manager".into(),
+            old: seat.clone(),
+            new,
+        });
+    }
+    for id in teamspaces {
+        set_default_manager(tree, &id, target.clone())?;
+        out.push(Rewrite {
+            holder: id.to_any(),
+            field: "default_manager".into(),
+            old: seat.clone(),
+            new: target.clone(),
+        });
+    }
+    Ok((out, note))
+}
+
+/// Plan preview for seats retiring together: for each live seat (not itself in `retiring`) whose explicit manager is
+/// in `retiring`, and each non-retired teamspace whose default_manager is in `retiring`, one seat.manager /
+/// teamspace.default_manager effect (`seat_manager_effect` / `default_manager_effect`) from the retiring seat to its
+/// nearest surviving manager, skipping every seat in `retiring`. Holders are visited in id order. A retiring holder
+/// gets no effect: its pointer is archived with it, so preview and apply agree on final pointers of live holders.
+pub fn reparent_effects(
+    tree: &dyn TreeRead,
+    retiring: &[SeatId],
+) -> Result<Vec<PlanEffect>, StoreError> {
+    let retiring: BTreeSet<SeatId> = retiring.iter().cloned().collect();
+    let pointers = Pointers::load(tree)?;
+    let mut seats: Vec<(&SeatId, &SeatId)> = pointers
+        .seats
+        .iter()
+        .filter(|(id, p)| !p.retired && !retiring.contains(*id))
+        .filter_map(|(id, p)| p.manager.as_ref().map(|m| (id, m)))
+        .filter(|(_, m)| retiring.contains(*m))
+        .collect();
+    seats.sort();
+    let mut out = Vec::new();
+    for (id, old) in seats {
+        let target = pointers.nearest_surviving_manager(old, &retiring)?;
+        // Mirrors `reparent`: never point a seat at itself.
+        let new = target.filter(|t| t != id);
+        out.push(seat_manager_effect(id, Some(old), new.as_ref()));
+    }
+    let mut teamspaces = Vec::new();
+    for (_, ts) in layout::list_teamspaces(tree)? {
+        if ts.lifecycle != crate::model::common::Lifecycle::Retired
+            && let Some(old) = ts.default_manager.as_ref()
+            && retiring.contains(old)
+        {
+            teamspaces.push((ts.id.clone(), old.clone()));
+        }
+    }
+    teamspaces.sort();
+    for (id, old) in teamspaces {
+        let target = pointers.nearest_surviving_manager(&old, &retiring)?;
+        out.push(default_manager_effect(&id, Some(&old), target.as_ref()));
+    }
+    Ok(out)
+}
+
+#[cfg(test)]
+pub(crate) mod testing {
+    use crate::model::change::{ChangeRequest, RequestKind, Requester};
+    use crate::model::{SeatId, TeamspaceId};
+    use crate::writer::{Applied, Mutation, MutationCx, MutationError};
+    use serde_json::json;
+
+    /// Registry key of `SetPointer`; fixtures add `reg.register(SET_POINTER_KEY, Arc::new(SetPointer))`.
+    pub const SET_POINTER_KEY: &str = "bookkeeping.test_pointer";
+
+    /// Test-only mutation: args `{"seat": "<st>"}` or `{"teamspace": "<ts>"}`, plus `"manager": "<st>"|null`; writes
+    /// through `super::super::set_seat_manager` / `set_default_manager`. Writes any id, dangling ones included.
+    pub struct SetPointer;
+    impl Mutation for SetPointer {
+        fn apply(&self, cx: &mut MutationCx<'_>) -> Result<Applied, MutationError> {
+            let bug = |what: &str, e: &dyn std::fmt::Display| {
+                MutationError::Bug(format!("test_pointer {what}: {e}"))
+            };
+            let manager: Option<SeatId> = match cx.request.args["manager"].as_str() {
+                Some(s) => Some(s.parse().map_err(|e| bug("manager", &e))?),
+                None => None,
+            };
+            if let Some(s) = cx.request.args["seat"].as_str() {
+                let seat: SeatId = s.parse().map_err(|e| bug("seat", &e))?;
+                super::super::set_seat_manager(&mut cx.tree, &seat, manager)?;
+            } else if let Some(s) = cx.request.args["teamspace"].as_str() {
+                let ts: TeamspaceId = s.parse().map_err(|e| bug("teamspace", &e))?;
+                super::super::set_default_manager(&mut cx.tree, &ts, manager)?;
+            } else {
+                return Err(MutationError::Bug("test_pointer: no target".into()));
+            }
+            Ok(Applied {
+                summary: "set pointer".into(),
+                action: None,
+            })
+        }
+    }
+
+    fn request(args: serde_json::Value) -> ChangeRequest {
+        ChangeRequest {
+            kind: RequestKind::Bookkeeping,
+            args,
+            relied_on: vec![],
+            requester: Requester::default(),
+            supersedes: None,
+            confirmed: None,
+        }
+    }
+
+    /// The rewrites an action record lists under `reparented` (empty when it lists none).
+    pub fn recorded(act: &crate::model::action::ActionRecord) -> Vec<super::Rewrite> {
+        act.compensation
+            .get(super::REPARENTED_KEY)
+            .and_then(|v| v.as_array())
+            .map(|rows| {
+                rows.iter()
+                    .map(|r| super::Rewrite::from_toml(r).expect("well-formed rewrite row"))
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
+
+    pub fn seat_request(seat: &SeatId, manager: Option<&SeatId>) -> ChangeRequest {
+        request(json!({ "sub": "test_pointer", "seat": seat, "manager": manager }))
+    }
+
+    pub fn teamspace_request(ts: &TeamspaceId, manager: Option<&SeatId>) -> ChangeRequest {
+        request(json!({ "sub": "test_pointer", "teamspace": ts, "manager": manager }))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rewrite_toml_round_trip() {
+        let with = Rewrite {
+            holder: SeatId::new().to_any(),
+            field: "manager".into(),
+            old: SeatId::new(),
+            new: Some(SeatId::new()),
+        };
+        assert_eq!(Rewrite::from_toml(&with.to_toml()).as_ref(), Some(&with));
+        let without = Rewrite {
+            new: None,
+            field: "default_manager".into(),
+            ..with.clone()
+        };
+        let v = without.to_toml();
+        assert!(v.as_table().unwrap().get("new").is_none());
+        assert_eq!(Rewrite::from_toml(&v), Some(without));
+        assert_eq!(Rewrite::from_toml(&toml::Value::Boolean(true)), None);
+    }
+}
