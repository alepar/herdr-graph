++pub fn unresolved(
++    holder: impl std::fmt::Display,
++    field: &str,
++    target: impl std::fmt::Display,
++) -> StoreError {
++    StoreError::Integrity {
++        holder: holder.to_string(),
++        field: field.to_string(),
++        target: target.to_string(),
++        reason: "not found at the committed revision".to_string(),
++    }
+ }
