+/// Stamp the clone's binding the way the observer does (token, Present).
+fn set_binding(fx: &Fx, clone: &CloneId, token: bool, present: bool, pane: Option<&HerdrPaneId>) {
+    bookkeeping(
+        fx,
+        "test_set_binding",
