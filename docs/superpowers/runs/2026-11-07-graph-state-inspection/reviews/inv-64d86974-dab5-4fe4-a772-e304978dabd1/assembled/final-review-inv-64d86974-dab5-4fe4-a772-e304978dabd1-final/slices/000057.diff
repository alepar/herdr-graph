+/// Largest stdin payload read, and the longest wait for it. A held-open stdin costs the hook at most
+/// [`STDIN_WAIT`] after its output is printed.
+const STDIN_CAP: u64 = 64 * 1024;
+const STDIN_WAIT: std::time::Duration = std::time::Duration::from_secs(2);
+
+/// The hook's stdin payload, or None for a terminal, an error, a timeout or an empty read. Reads on a helper
+/// thread so a stdin that never closes cannot hold the process: the thread is abandoned and exit ends it.
+fn read_stdin_payload() -> Option<Vec<u8>> {
+    use std::io::{IsTerminal, Read};
+    let stdin = std::io::stdin();
+    if stdin.is_terminal() {
+        return None;
+    }
+    let (tx, rx) = std::sync::mpsc::channel();
+    std::thread::spawn(move || {
+        let mut buf = Vec::new();
+        let _ = std::io::stdin().take(STDIN_CAP).read_to_end(&mut buf);
+        let _ = tx.send(buf);
+    });
+    rx.recv_timeout(STDIN_WAIT).ok().filter(|b| !b.is_empty())
+}
+
+/// `session_id` of a hook payload (Claude SessionStart and Codex SessionStart both carry it); None when
+/// absent, not a string, or the payload is not JSON.
+pub fn payload_session_id(payload: &[u8]) -> Option<String> {
+    let v: serde_json::Value = serde_json::from_slice(payload).ok()?;
+    v.get("session_id")?.as_str().map(str::to_owned)
 }
 
