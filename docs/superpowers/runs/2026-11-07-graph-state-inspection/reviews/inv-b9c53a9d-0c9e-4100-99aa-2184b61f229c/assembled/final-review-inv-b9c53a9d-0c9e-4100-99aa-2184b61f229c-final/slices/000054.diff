+/// The one roster builder (daemon-free CLI and the daemon's roster.live). `at` is the invocation's pinned HEAD.
+pub fn build(store: &GitStore, at: &CommitId, q: &RosterQuery) -> Result<Roster, StoreError> {
+    build_with_cap(store, at, q, HistoryWalker::DEFAULT_MAX_SCAN)
+}
+
+fn build_with_cap(
+    store: &GitStore,
+    at: &CommitId,
+    q: &RosterQuery,
+    max_scan: usize,
+) -> Result<Roster, StoreError> {
+    build_inner(store, at, q, false, max_scan).map(|(r, _)| r)
+}
+
+/// [`build`] plus the committed bindings the live overlay compares with a snapshot. `all_bindings` also
+/// collects every non-retired binding of the whole instance (whatever the scope), for `--unmanaged`.
+pub fn build_with_bindings(
+    store: &GitStore,
+    at: &CommitId,
+    q: &RosterQuery,
+    all_bindings: bool,
+) -> Result<(Roster, Bindings), StoreError> {
+    build_inner(store, at, q, all_bindings, HistoryWalker::DEFAULT_MAX_SCAN)
+}
+
+fn build_inner(
+    store: &GitStore,
+    at: &CommitId,
+    q: &RosterQuery,
+    all_bindings: bool,
+    max_scan: usize,
+) -> Result<(Roster, Bindings), StoreError> {
+    let mut bindings = Bindings::default();
+    let inv = Inventory::load(store, at, &q.scope)?;
+    let view = CommitView {
+        store: store as &dyn Store,
+        at: at.clone(),
+    };
+    let pointers = Pointers::load(&view)?;
+    let node_manager = pointers.live_node_manager();
+
+    let mut teamspaces = Vec::new();
+    for t in &inv.teamspaces {
+        let mut seats = Vec::new();
+        for s in &t.seats {
+            if s.record.lifecycle == Lifecycle::Retired && !q.all {
+                continue;
+            }
+            let manager = pointers
+                .effective_manager(&s.record.id)
+                .ok()
+                .flatten()
+                .map(|id| ManagerRef {
+                    name: pointers.name(&id).unwrap_or(id.as_str()).to_owned(),
+                    id,
+                });
+            // Each clone's loaded record is compared against this render.
+            let rendered: Result<RenderedInstructions, StoreError> =
+                render_instructions(&view, at, &s.record.id);
+            let clones = s
+                .clones
+                .iter()
+                .filter(|c| q.all || c.record.lifecycle != CloneLifecycle::Retired)
+                .map(|c| {
+                    let r = &c.record;
+                    let occupant = r.occupant.as_ref().map(|o| {
+                        let cur = c.current();
+                        OccupantView {
+                            harness: o.harness,
+                            native_session: o.native_session.clone(),
+                            native_session_id: cur.map(|e| e.session.native_session_id.clone()),
+                            transcript: cur.and_then(|e| e.transcript.clone()),
+                            since: o.since,
+                        }
+                    });
+                    let threads = r.threads_seat.as_ref().map(|seat| ThreadsView {
+                        seat: seat.clone(),
+                        state: r
+                            .seat_fact
+                            .as_ref()
+                            .map(|f| state_word(&f.state).to_owned()),
+                        read_at: r.seat_fact.as_ref().map(|f| f.read_at),
+                    });
+                    if let Some(b) = &r.runtime.bound {
+                        bindings.clones.insert(r.id.clone(), b.clone());
+                    }
+                    let instructions = match &rendered {
+                        Ok(head) => loaded::clone_view(
+                            store,
+                            at,
+                            &r.id,
+                            occupant
+                                .as_ref()
+                                .and_then(|o| o.native_session_id.as_deref()),
+                            head,
+                        ),
+                        Err(e) => InstructionsView::error(e.to_string()),
+                    };
+                    RosterClone {
+                        id: r.id.clone(),
+                        name: r.name.clone(),
+                        lifecycle: r.lifecycle,
+                        runtime: c.runtime.clone(),
+                        occupant,
+                        threads,
+                        instructions,
+                        live: None,
+                    }
+                })
+                .collect();
+            seats.push(RosterSeat {
+                id: s.record.id.clone(),
+                name: s.record.name.clone(),
+                lifecycle: s.record.lifecycle,
+                manager,
+                is_node_manager: node_manager.as_ref() == Some(&s.record.id),
+                reload_required: s.record.reload_required,
+                last_change: None,
+                last_change_scanned: None,
+                clones,
+            });
+        }
+        let own = q.scope.contains(Member::Teamspace(&t.record.id))
+            && matches!(q.scope, Scope::Teamspace(_));
+        if !seats.is_empty() || own {
+            teamspaces.push(RosterTeamspace {
+                id: t.record.id.clone(),
+                name: t.record.name.clone(),
+                lifecycle: t.record.lifecycle,
+                seats,
+            });
+        }
+    }
+    if all_bindings {
+        let whole = Inventory::load(store, at, &Scope::Instance)?;
+        for t in &whole.teamspaces {
+            if t.record.lifecycle != Lifecycle::Retired {
+                bindings.all.extend(t.record.runtime.bound.clone());
+            }
+            for s in &t.seats {
+                if s.record.lifecycle != Lifecycle::Retired {
+                    bindings.all.extend(s.record.runtime.bound.clone());
+                }
+                for c in &s.clones {
+                    if c.record.lifecycle != CloneLifecycle::Retired {
+                        bindings.all.extend(c.record.runtime.bound.clone());
+                    }
+                }
+            }
+        }
+    }
+    let scan = fill_last_changes(store, at, &mut teamspaces, max_scan)?;
+    let roster = Roster {
+        live_unavailable: None,
+        scan,
+        threads_live: None,
+        unmanaged: None,
+        teamspaces,
+    };
+    Ok((roster, bindings))
+}
+
+fn label(s: &str) -> Option<String> {
+    (!s.is_empty()).then(|| s.to_owned())
+}
+
+/// Fill the live slots from one snapshot (or its failure). Pure: no I/O.
+pub fn overlay(
+    roster: &mut Roster,
+    bindings: &Bindings,
+    snap: Result<&HerdrSnapshot, String>,
+    threads: ThreadsRead,
+    unmanaged: bool,
+) {
+    let mut unavailable = LiveUnavailable {
+        herdr: None,
+        threads: None,
+    };
+    match &threads {
+        ThreadsRead::Ok { refusals, lost } => {
+            roster.threads_live = Some(ThreadsLive {
+                seat_refusals: Some(refusals.clone()),
+                seat_lost: Some(lost.clone()),
+            });
+        }
+        ThreadsRead::Unavailable(reason) => {
+            roster.threads_live = Some(ThreadsLive {
+                seat_refusals: None,
+                seat_lost: None,
+            });
+            unavailable.threads = Some(reason.clone());
+        }
+    }
+    match snap {
+        Err(reason) => {
+            unavailable.herdr = Some(reason);
+            for c in roster
+                .teamspaces
+                .iter_mut()
+                .flat_map(|t| &mut t.seats)
+                .flat_map(|s| &mut s.clones)
+            {
+                c.live = None;
+            }
+            roster.unmanaged = unmanaged.then_some(None);
+        }
+        Ok(snap) => {
+            for c in roster
+                .teamspaces
+                .iter_mut()
+                .flat_map(|t| &mut t.seats)
+                .flat_map(|s| &mut s.clones)
+            {
+                let binding = bindings.clones.get(&c.id);
+                let same = binding.is_some_and(|b| b.incarnation.same_server(&snap.incarnation));
+                let pane = binding.filter(|_| same).and_then(|b| find_pane(snap, b));
+                c.live = Some(CloneLive {
+                    agent: pane.and_then(|p| p.agent.as_ref()).map(|a| AgentView {
+                        kind: a.kind.clone(),
+                        status: a.status,
+                    }),
+                    live_pane_matches: pane.is_some(),
+                    binding_from_earlier_server: binding.is_some() && !same,
+                });
+            }
+            roster.unmanaged = unmanaged.then(|| Some(unmanaged_of(snap, &bindings.all)));
+        }
+    }
+    roster.live_unavailable =
+        (unavailable.herdr.is_some() || unavailable.threads.is_some()).then_some(unavailable);
+}
+
+/// The snapshot's pane named by `b` (workspace, tab and pane all present and nested), if any.
+fn find_pane<'a>(
+    snap: &'a HerdrSnapshot,
+    b: &Binding,
+) -> Option<&'a crate::ports::herdr::PaneInfo> {
+    let (w, t, p) = (
+        b.workspace_id.as_ref()?,
+        b.tab_id.as_ref()?,
+        b.pane_id.as_ref()?,
+    );
+    snap.workspaces
+        .iter()
+        .find(|ws| &ws.id == w)?
+        .tabs
+        .iter()
+        .find(|tb| &tb.id == t)?
+        .panes
+        .iter()
+        .find(|pn| &pn.id == p)
+}
+
+/// Snapshot objects not named by any same-server binding in `bound`.
+fn unmanaged_of(snap: &HerdrSnapshot, bound: &[Binding]) -> Unmanaged {
+    let same: Vec<&Binding> = bound
+        .iter()
+        .filter(|b| b.incarnation.same_server(&snap.incarnation))
+        .collect();
+    let mut out = Unmanaged {
+        workspaces: vec![],
+        tabs: vec![],
+        panes: vec![],
+    };
+    for w in &snap.workspaces {
+        if !same.iter().any(|b| b.workspace_id.as_ref() == Some(&w.id)) {
+            out.workspaces.push(UnWorkspace {
+                id: w.id.clone(),
+                label: label(&w.label),
+            });
+        }
+        for t in &w.tabs {
+            if !same.iter().any(|b| b.tab_id.as_ref() == Some(&t.id)) {
+                out.tabs.push(UnTab {
+                    id: t.id.clone(),
+                    label: label(&t.label),
+                    workspace: w.id.clone(),
+                });
+            }
+            for p in &t.panes {
+                if !same.iter().any(|b| b.pane_id.as_ref() == Some(&p.id)) {
+                    out.panes.push(UnPane {
+                        id: p.id.clone(),
+                        label: p.label.clone().filter(|l| !l.is_empty()),
+                        tab: t.id.clone(),
+                    });
+                }
+            }
+        }
+    }
+    out
+}
+
+/// One `HistoryWalker` pass for every listed seat; matching is `LogQuery::matches` on the seat's scope.
+/// `None` (no pass) when no seat is listed.
+fn fill_last_changes(
+    store: &GitStore,
+    at: &CommitId,
+    teamspaces: &mut [RosterTeamspace],
+    max_scan: usize,
+) -> Result<Option<ScanReport>, StoreError> {
+    let mut pending: Vec<(&mut RosterSeat, LogQuery)> = teamspaces
+        .iter_mut()
+        .flat_map(|t| t.seats.iter_mut())
+        .map(|s| {
+            let q = LogQuery {
+                scope: Scope::Seat(s.id.clone()),
+                by: None,
+                all: false,
+                since: None,
+                limit: 1,
+            };
+            (s, q)
+        })
+        .collect();
+    if pending.is_empty() {
+        return Ok(None);
+    }
+    let mut failed: Option<StoreError> = None;
+    let report = HistoryWalker::new(store, at, max_scan).walk(|c| {
+        for (seat, q) in pending.iter_mut().filter(|(s, _)| s.last_change.is_none()) {
+            match q.matches(store, c) {
+                Ok(true) => {
+                    seat.last_change = Some(LastChange {
+                        at: c.at,
+                        op: c.trailers.op.clone(),
+                        summary: c
+                            .operation
+                            .as_ref()
+                            .map_or_else(|| c.summary.clone(), |o| o.summary.clone()),
+                    });
+                }
+                Ok(false) => {}
+                Err(e) => {
+                    failed.get_or_insert(e);
+                }
+            }
+        }
+        if failed.is_some() || pending.iter().all(|(s, _)| s.last_change.is_some()) {
+            ControlFlow::Break(())
+        } else {
+            ControlFlow::Continue(())
+        }
+    })?;
+    if let Some(e) = failed {
+        return Err(e);
+    }
+    for (seat, _) in &mut pending {
+        seat.last_change_scanned = Some(seat.last_change.is_some() || !report.stopped_early);
+    }
+    Ok(Some(report))
+}
+
+fn word<T: Serialize>(v: &T) -> String {
+    match serde_json::to_value(v) {
+        Ok(serde_json::Value::String(s)) => s,
+        _ => "?".into(),
+    }
+}
+
+pub(crate) fn instructions_text(i: &InstructionsView) -> String {
+    let mut s = match i.status {
+        InstructionsStatus::Current => match &i.loaded_rev {
+            Some(r) => format!("current @{}", &r[..r.len().min(12)]),
+            None => "current".into(),
+        },
+        InstructionsStatus::Stale => format!("stale ({} parts)", i.stale_parts.len()),
+        InstructionsStatus::Unknown => match &i.loaded_rev {
+            Some(r) => format!(
+                "unknown (loaded @{} into {})",
+                &r[..r.len().min(12)],
+                i.loaded_session
+                    .as_deref()
+                    .unwrap_or("session not identified")
+            ),
+            None => "unknown".into(),
+        },
+        InstructionsStatus::Error => {
+            format!("error: {}", i.message.as_deref().unwrap_or("unknown error"))
+        }
+    };
+    if i.truncated {
+        s.push_str(" truncated");
+    }
+    if let Some(n) = &i.note {
+        let _ = write!(s, " [{n}]");
+    }
+    s
+}
+
+fn clone_line(c: &RosterClone) -> String {
+    let rt = &c.runtime;
+    let pane = if rt.workspace.is_none() && rt.tab.is_none() && rt.pane.is_none() {
+        "-".to_owned()
+    } else {
+        let part = |v: Option<String>| v.unwrap_or_else(|| "?".into());
+        format!(
+            "{}:{}:{}",
+            part(rt.workspace.as_ref().map(|w| w.to_string())),
+            part(rt.tab.as_ref().map(|t| t.to_string())),
+            part(rt.pane.as_ref().map(|p| p.to_string()))
+        )
+    };
+    let occupant = match &c.occupant {
+        None => "-".to_owned(),
+        Some(o) => {
+            let native = o.native_session_id.as_deref().unwrap_or("-");
+            let transcript = o
+                .transcript
+                .as_ref()
+                .map_or("unresolved".to_owned(), |t| t.path.display().to_string());
+            format!(
+                "{} {} ({native}, {transcript}) since {}",
+                word(&o.harness),
+                o.native_session,
+                o.since.format("%H:%MZ")
+            )
+        }
+    };
+    let (tseat, tstate) = match &c.threads {
+        None => ("-".to_owned(), "-".to_owned()),
+        Some(t) => (
+            t.seat.clone(),
+            t.state.clone().unwrap_or_else(|| "-".into()),
+        ),
+    };
+    let mut line = format!(
+        "{} ({})  {}  {}  {}  threads {}  {}  instructions: {}",
+        c.name,
+        c.id,
+        word(&rt.availability),
+        pane,
+        occupant,
+        tseat,
+        tstate,
+        instructions_text(&c.instructions)
+    );
+    if let Some(l) = &c.live {
+        line.push_str("  ");
+        line.push_str(
+            &match (&l.agent, l.live_pane_matches, l.binding_from_earlier_server) {
+                (Some(a), _, _) => format!("agent {} {}", a.kind, word(&a.status)),
+                (None, true, _) => "no agent".to_owned(),
+                (None, false, true) => "binding from earlier herdr server".to_owned(),
+                (None, false, false) => "no live pane".to_owned(),
+            },
+        );
+    }
+    line
+}
+
+fn dash(l: &Option<String>) -> &str {
+    l.as_deref().unwrap_or("-")
+}
+
+impl View for Roster {
+    fn render_text(&self, out: &mut String) {
+        if let Some(u) = &self.live_unavailable {
+            let parts: Vec<String> = [("herdr", &u.herdr), ("threads", &u.threads)]
+                .into_iter()
+                .filter_map(|(k, v)| v.as_ref().map(|r| format!("{k}: {r}")))
+                .collect();
+            let _ = writeln!(out, "live data unavailable: {}", parts.join("; "));
+        }
+        for t in &self.teamspaces {
+            let _ = writeln!(out, "{} ({}) {}", t.name, t.id, word(&t.lifecycle));
+            for s in &t.seats {
+                let mut line = format!("  {} ({}) {}", s.name, s.id, word(&s.lifecycle));
+                if let Some(m) = &s.manager {
+                    let _ = write!(line, "  manager: {}", m.name);
+                }
+                if s.is_node_manager {
+                    line.push_str("  node-manager");
+                }
+                if s.reload_required {
+                    line.push_str("  reload_required");
+                }
+                match (&s.last_change, s.last_change_scanned) {
+                    (Some(l), _) => {
+                        let _ = write!(
+                            line,
+                            "  last change {} {}",
+                            l.at.format("%Y-%m-%d %H:%MZ"),
+                            l.summary
+                        );
+                    }
+                    (None, Some(false)) => line.push_str("  last change older than scan"),
+                    (None, _) => line.push_str("  last change -"),
+                }
+                let _ = writeln!(out, "{line}");
+                for c in &s.clones {
+                    let _ = writeln!(out, "    {}", clone_line(c));
+                }
+            }
+        }
+        if let Some(tl) = &self.threads_live {
+            for (seat, msg) in tl.seat_refusals.iter().flatten() {
+                let _ = writeln!(out, "threads seat refused: {seat}: {msg}");
+            }
+            for lost in tl.seat_lost.iter().flatten() {
+                let _ = writeln!(out, "threads seat lost: {lost}");
+            }
+        }
+        if let Some(Some(u)) = &self.unmanaged {
+            let _ = writeln!(out, "unmanaged:");
+            for w in &u.workspaces {
+                let _ = writeln!(out, "  workspace {} {}", w.id, dash(&w.label));
+            }
+            for t in &u.tabs {
+                let _ = writeln!(out, "  tab {} {} in {}", t.id, dash(&t.label), t.workspace);
+            }
+            for p in &u.panes {
+                let _ = writeln!(out, "  pane {} {} in {}", p.id, dash(&p.label), p.tab);
+            }
+        }
+    }
+}
