+
+fn state_word(s: &SeatFactState) -> &'static str {
+    match s {
+        SeatFactState::Resolved { .. } => "resolved",
+        SeatFactState::Unresolved => "unresolved",
+        SeatFactState::KeyConflict { .. } => "key_conflict",
+        SeatFactState::Retired { .. } => "retired",
+    }
+}
