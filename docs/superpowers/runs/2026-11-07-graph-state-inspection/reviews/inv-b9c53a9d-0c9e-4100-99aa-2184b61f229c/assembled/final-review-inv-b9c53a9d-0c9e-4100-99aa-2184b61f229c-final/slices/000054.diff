+        let moved = s.workspaces[0].tabs[0].panes.remove(0);
+        s.workspaces[1].tabs[0].panes.push(moved);
+        overlay(&mut r, &b, Ok(&s), threads_ok(), false);
+        let live = clone_of(&r, &w.present).live.clone().unwrap();
