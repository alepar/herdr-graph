+/// harness_hook: per harness with an owned SessionStart hook, whether the installed command is the current one
+/// (an older one runs but cannot record the loaded session), and for Codex that a changed hook needs a fresh
+/// trust. Graph cannot read Codex trust and never writes it.
+pub fn harness_hook_checks(claude: Option<&Path>, codex: Option<&Path>) -> Vec<Check> {
+    use crate::bootstrap::setup_claude::{CLAUDE, CODEX, owned_hook_current};
+    let mut out = Vec::new();
+    for (name, target, dir) in [("claude", &CLAUDE, claude), ("codex", &CODEX, codex)] {
+        let Some(dir) = dir else { continue };
+        let label = format!("harness_hook {name}");
+        match owned_hook_current(target, dir) {
+            Ok(None) => {}
+            Err(e) => out.push(warn_check(&label, e.to_string())),
+            Ok(Some(false)) => out.push(warn_check(
+                &label,
+                format!("outdated herdr-graph hook; run herdr-graph setup {name}"),
+            )),
+            Ok(Some(true)) if name == "codex" => out.push(warn_check(
+                &label,
+                "Codex runs a changed hook only after you trust it in /hooks; graph cannot check Codex trust",
+            )),
+            Ok(Some(true)) => out.push(check(&label, true, "current")),
+        }
+    }
+    out
+}
