+    /// `Unsupported`.
+    pub fn enable_resurrect(&self, view: Arc<FakeThreadsSeatView>, clock: Arc<dyn Clock>) {
+        self.lock().model = Some((view, clock));
+    }
+
+    /// Apply the 24 h and 7 d windows at the model clock's now (`resurrect_seat` runs this first).
