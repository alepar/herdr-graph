+// -------------------------------------------------------------------------------------------------
+// restart rebind and the keyless start gate (hg-lnw.13, spec §4)
+// -------------------------------------------------------------------------------------------------
+
+use crate::ports::threads::{SeatStatus, ThreadsSeatRef};
+use crate::reconcile::planner::{
+    rebind_refused_in, rebind_refused_key, seat_unresolved_in, seat_unresolved_key,
+};
+use crate::threads::fake::{FakeThreads, FakeThreadsSeatView};
+
+const HELD_SEAT: &str = "seat-1";
+
+/// A foreman clone after a cold Herdr restart with threads on the fakes (the resurrect model on): its seat is
+/// held for the restart (reads `Unresolved`, saved pane = the clone's pane), graph's fact for it is a fresh
+/// `Unresolved` read, and no step has run since.
+struct Restarted {
+    fx: Fx,
+    keyless: bool,
+    threads: Arc<FakeThreads>,
+    view: Arc<FakeThreadsSeatView>,
+    clone: CloneRecord,
+    pane: HerdrPaneId,
+}
+
+/// What the clone had before the restart.
+#[derive(Clone, Copy, PartialEq)]
+enum Had {
+    /// An agent whose session `abc` ended.
+    Session,
+    /// An agent graph launched whose session was never captured (`launched:` meta only).
+    LaunchedOnly,
+    /// No agent was ever started: no session and no `launched:` meta.
+    Nothing,
+}
+
+async fn restarted(keyless: bool, had: Had, harness: &str) -> Restarted {
+    let fx = fx();
+    let threads = Arc::new(FakeThreads::new());
+    let map = Arc::new(crate::threads::mapping::FakePaneSeatMap::new());
+    let view = Arc::new(FakeThreadsSeatView::new());
+    activate(&fx, harness);
+    if keyless {
+        // As `keyless_claude`: the clone is adopted before any key is reserved, so threads reserves none.
+        step_unreserved(&fx).await;
+        seat_state(
+            &fx,
+            &only_clone(&fx, "foreman").id,
+            json!({ "keyless": true }),
+        );
+        crate::threads::register_with(&fx.rec, threads.clone(), map, view.clone());
+        step_unreserved(&fx).await;
+    } else {
+        crate::threads::register_with(&fx.rec, threads.clone(), map, view.clone());
+        steps(&fx, 3).await;
+    }
+    threads.enable_resurrect(view.clone(), fx.clock.clone());
+    let c = only_clone(&fx, "foreman");
+    if had == Had::Session {
+        end_session(&fx, &c, "abc", harness);
+    }
+    if had == Had::Nothing {
+        let _ = fx
+            .journal
+            .meta_delete(&crate::reconcile::planner::launched_key(&c.id));
+    }
+    if had == Had::Nothing {
+        // Seated before the restart, never launched: the pre-restart fact (Resolved, stale) is in hand when
+        // the restart is first seen, so the ordinary start rule meets the keyless gate in that very step.
+        seat_state(
+            &fx,
+            &c.id,
+            json!({ "threads_seat": HELD_SEAT,
+                    "fact": fact(HELD_SEAT, SeatFactState::Resolved { pane: pane_of(&fx, &c) }, fx.clock.now()) }),
+        );
+    }
+    let pane = if keyless {
+        // `cold_restart` records key reservations; an adopted clone has none.
+        fx.herdr.restart(true, true);
+        step_unreserved(&fx).await;
+        let pane = token_pane(&fx, &c.id).await;
+        fx.herdr.set_agent(&pane, None);
+        fx.herdr.clear_calls();
+        pane
+    } else {
+        cold_restart(&fx, &c.id).await
+    };
+    keep_pane_id(&fx, &c.id, &pane);
+    if had == Had::Nothing {
+        let _ = fx
+            .journal
+            .meta_delete(&crate::reconcile::planner::launched_key(&c.id));
+    }
+    threads.hold_for_restart(&ThreadsSeatRef(HELD_SEAT.into()), &pane);
+    seat_state(
+        &fx,
+        &c.id,
+        json!({ "threads_seat": HELD_SEAT, "fact": unresolved(HELD_SEAT, fx.clock.now()) }),
+    );
+    fx.herdr.clear_calls();
+    Restarted {
+        keyless,
+        clone: the_clone(&fx, &c.id),
+        fx,
+        threads,
+        view,
+        pane,
+    }
+}
+
+impl Restarted {
+    /// One reconcile step; keyless clones record no key reservation (as `keyless_claude`'s tests).
+    async fn step(&self) -> StepReport {
+        if self.keyless {
+            step_unreserved(&self.fx).await
+        } else {
+            step(&self.fx).await
+        }
+    }
+
+    /// Observer stand-in: the fact graph holds now mirrors what the seat view reads.
+    fn observe(&self) {
+        let state = match self.view.status(&ThreadsSeatRef(HELD_SEAT.into())) {
+            Some(SeatStatus::Resolved { pane }) => SeatFactState::Resolved { pane },
+            _ => SeatFactState::Unresolved,
+        };
+        seat_state(
+            &self.fx,
+            &self.clone.id,
+            json!({ "fact": fact(HELD_SEAT, state, self.fx.clock.now()) }),
+        );
+    }
+
+    fn rebinds(&self) -> usize {
+        self.threads.call_count("rebind_held_seat")
+    }
+
+    fn advance(&self, secs: i64) {
+        self.fx.clock.advance(chrono::Duration::seconds(secs));
+    }
+
+    fn seat_is_placed(&self) -> bool {
+        self.view.status(&ThreadsSeatRef(HELD_SEAT.into()))
+            == Some(SeatStatus::Resolved {
+                pane: self.pane.clone(),
+            })
+    }
+
+    fn refused(&self) -> Option<String> {
+        let changed = crate::reconcile::planner::incarnation_changed_at(&self.fx.journal).unwrap();
+        rebind_refused_in(&self.fx.journal, &self.clone.id, changed)
+    }
+}
+
+#[tokio::test]
+async fn restart_keyed_session_seat_rebinds_and_resumes_without_waiting() {
+    // Rows 1-2: the rebind runs; the keyed relaunch is the ordinary one (waits the grace, not the rebind).
+    for had in [Had::Session, Had::LaunchedOnly] {
+        let r = restarted(false, had, "claude").await;
+        r.step().await;
+        assert_eq!(r.rebinds(), 1);
+        assert!(r.seat_is_placed());
+        assert_eq!(relaunch_rows(&r.fx), 1);
+        assert!(start_calls(&r.fx).is_empty(), "inside the 90 s grace");
+        r.advance(91);
+        r.step().await;
+        let starts = start_calls(&r.fx);
+        assert_eq!(starts.len(), 1, "{:?}", calls(&r.fx));
+        assert_eq!(
+            starts[0].args,
+            if had == Had::Session {
+                vec!["--resume", "abc"]
+            } else {
+                Vec::<&str>::new()
+            }
+        );
+        assert_eq!(starts[0].env, agent_env(&r.clone.id, true));
+    }
+}
