+#[tokio::test]
+async fn undo_then_restart_rebinds_and_relaunches_once() {
+    // Undo: the Restore launch ran and its mark is on record; then Herdr restarts before the agent reattaches.
+    let fx = fx();
+    let threads = Arc::new(FakeThreads::new());
+    let map = Arc::new(crate::threads::mapping::FakePaneSeatMap::new());
+    let view = Arc::new(FakeThreadsSeatView::new());
+    crate::threads::register_with(&fx.rec, threads.clone(), map, view.clone());
+    threads.enable_resurrect(view.clone(), fx.clock.clone());
+    let epoch = OpId::new();
+    let (c, _) = restored_clone(&fx, &epoch).await;
+    step(&fx).await;
+    assert_eq!(start_calls(&fx).len(), 1, "the restore launch");
+    fx.clock.advance(chrono::Duration::seconds(30));
+    let pane = cold_restart(&fx, &c.id).await;
+    keep_pane_id(&fx, &c.id, &pane);
+    threads.hold_for_restart(&ThreadsSeatRef("seat-1".into()), &pane);
+    seat_state(
+        &fx,
+        &c.id,
+        json!({ "fact": unresolved("seat-1", fx.clock.now()) }),
+    );
+    step(&fx).await;
+    assert_eq!(threads.call_count("rebind_held_seat"), 1);
+    assert!(start_calls(&fx).is_empty(), "inside the grace");
+    fx.clock.advance(chrono::Duration::seconds(91));
+    step(&fx).await;
+    let starts = start_calls(&fx);
+    assert_eq!(starts.len(), 1, "{:?}", calls(&fx));
+    assert_eq!(starts[0].args, ["--resume", "abc"]);
+    fx.herdr.clear_calls();
+    for _ in 0..3 {
+        fx.clock.advance(chrono::Duration::seconds(120));
+        step(&fx).await;
+    }
+    assert!(start_calls(&fx).is_empty(), "relaunched exactly once");
+    assert_eq!(
+        threads.call_count("rebind_held_seat"),
+        1,
+        "rebound exactly once"
+    );
+}
