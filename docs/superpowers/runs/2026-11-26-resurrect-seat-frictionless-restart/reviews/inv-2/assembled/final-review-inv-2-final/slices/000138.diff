+        // --- graph-local failures on the restore path are retryable (hg-lnw.24) ---
+
+        const NODE_A: [u8; 16] = [1; 16];
+        const NODE_B: [u8; 16] = [2; 16];
+
+        /// An endpoint on `dir/graph` with the given explicit config; no service listens at any socket.
+        fn local_endpoint(
+            dir: &std::path::Path,
+            explicit: Result<Option<Discovered>, String>,
+            herdr_socket: PathBuf,
+        ) -> Arc<Endpoint> {
+            Arc::new(Endpoint {
+                inputs: DiscoveryInputs::default(),
+                explicit,
+                herdr_socket,
+                intents: dir.join("graph/.graph-local/threads-intents"),
+                graph_root: dir.join("graph"),
+            })
+        }
+
+        fn explicit(dir: &std::path::Path, node: [u8; 16]) -> Result<Option<Discovered>, String> {
+            Ok(Some(Discovered {
+                socket: dir.join("nobody-listens.sock"),
+                instance: herdr_threads::node::NodeUuid::from_bytes(node),
+            }))
+        }
+
+        /// Commit a namespace marker naming `node` (reached from `legacy`) under `epoch` on main.
+        fn commit_marker(root: &std::path::Path, node: [u8; 16], epoch: &str) {
+            let repo = git2::Repository::open(root).unwrap();
+            let parent = repo.head().unwrap().peel_to_commit().unwrap();
+            let marker = crate::threads::namespace::Transition {
+                version: 1,
+                node: herdr_threads::node::NodeUuid::from_bytes(node),
+                from: "legacy".into(),
+                previous_epoch: String::new(),
+                epoch: epoch.into(),
+                base_head: parent.id().to_string(),
+                op: epoch.into(),
+            };
+            let blob = repo.blob(&serde_json::to_vec(&marker).unwrap()).unwrap();
+            let mut builder = repo.treebuilder(Some(&parent.tree().unwrap())).unwrap();
+            builder
+                .insert(crate::threads::namespace::MARKER, blob, 0o100644)
+                .unwrap();
+            let tree = repo.find_tree(builder.write().unwrap()).unwrap();
+            let sig = git2::Signature::now("test", "test@example.invalid").unwrap();
+            repo.commit(Some("HEAD"), &sig, &sig, epoch, &tree, &[&parent])
+                .unwrap();
+        }
+
+        /// Both restore calls through the production port, under `epoch` when given: each must come back as the
+        /// retryable `Unreachable` refusal, so the executor retries it in the same incarnation.
+        async fn assert_restores_retryable(endpoint: &Arc<Endpoint>, epoch: Option<&str>) {
+            let lazy = LazyThreads::new(endpoint.clone());
+            let seat = ThreadsSeatRef("seat-a".into());
+            let pane = HerdrPaneId("w1:p1".into());
+            let calls = async {
+                (
+                    lazy.resurrect_seat(&seat, &pane, None, &OpKey("resurrect:o".into()))
+                        .await,
+                    lazy.rebind_held_seat(&seat, &pane, &OpKey("rebind:o".into()))
+                        .await,
+                )
+            };
+            let (resurrect, rebind) = match epoch {
+                Some(e) => {
+                    crate::threads::namespace::EXPECTED_EPOCH
+                        .scope(e.into(), calls)
+                        .await
+                }
+                None => calls.await,
+            };
+            let want = SeatRestoreOutcome::refused(SeatRestoreRefusal::Unreachable);
+            assert_eq!(resurrect, want, "resurrect_seat");
+            assert_eq!(rebind, want, "rebind_held_seat");
+        }
+
+        fn local_message<T>(r: Result<T, ThreadsError>) -> String {
+            match r {
+                Err(ThreadsError::Disconnected(m)) => {
+                    assert!(m.starts_with("graph-local: "), "{m}");
+                    m
+                }
+                Err(other) => panic!("expected a graph-local Disconnected, got {other:?}"),
+                Ok(_) => panic!("expected a graph-local Disconnected, got Ok"),
+            }
+        }
+
+        #[tokio::test]
+        async fn stale_snapshot_guard_is_a_retryable_restore_refusal() {
+            let dir = tempfile::tempdir().unwrap();
+            let endpoint = local_endpoint(
+                dir.path(),
+                explicit(dir.path(), NODE_A),
+                dir.path().join("host.sock"),
+            );
+            crate::store::init::init_instance(&endpoint.graph_root).unwrap();
+            commit_marker(&endpoint.graph_root, NODE_A, "epoch_a");
+            // Outside the committed epoch's scope: the call snapshot is stale.
+            let m = local_message(endpoint.guard().await);
+            assert!(m.contains("stale external call snapshot"), "{m}");
+            assert_restores_retryable(&endpoint, None).await;
+            assert_restores_retryable(&endpoint, Some("epoch_old")).await;
+        }
+
+        #[tokio::test]
