+            let dir = tempfile::tempdir().unwrap();
+            let endpoint = local_endpoint(
+                dir.path(),
+                explicit(dir.path(), NODE_B),
+                dir.path().join("host.sock"),
+            );
+            crate::store::init::init_instance(&endpoint.graph_root).unwrap();
+            commit_marker(&endpoint.graph_root, NODE_A, "epoch_a");
+            // The guard passes under the committed epoch; the discovered node is not the committed one.
+            let m = crate::threads::namespace::EXPECTED_EPOCH
+                .scope("epoch_a".into(), async { local_message(endpoint.locate()) })
+                .await;
+            assert!(m.contains("committed node"), "{m}");
+            assert_restores_retryable(&endpoint, Some("epoch_a")).await;
+        }
+
