+        /// A threads stand-in that answers one `SeatInspect` with threads' own `Unsupported` refusal.
+        fn refusing_seat_inspect(socket: &std::path::Path) -> tokio::task::JoinHandle<()> {
+            use herdr_threads::daemon::transport::{read_frame, write_frame};
+            use herdr_threads::protocol::commands::Command;
+            use herdr_threads::protocol::results::{ApiError, ErrorCode};
+            use herdr_threads::protocol::wire::{PROTOCOL_VERSION, WireRequest, WireResponse};
+            let listener = tokio::net::UnixListener::bind(socket).unwrap();
+            tokio::spawn(async move {
+                let (mut stream, _) = listener.accept().await.unwrap();
+                let request: WireRequest =
+                    serde_json::from_slice(&read_frame(&mut stream).await.unwrap()).unwrap();
+                assert!(matches!(request.command, Command::SeatInspect(_)));
+                let response = WireResponse {
+                    version: PROTOCOL_VERSION,
+                    request_id: request.request_id,
+                    instance: request.expected_instance,
+                    daemon_boot: "123e4567-e89b-12d3-a456-426614174001".into(),
+                    result: Err(ApiError::constructor_for(ErrorCode::Unsupported)(
+                        "unsupported command",
+                    )),
+                };
+                write_frame(&mut stream, &serde_json::to_vec(&response).unwrap())
+                    .await
+                    .unwrap();
+            })
+        }
