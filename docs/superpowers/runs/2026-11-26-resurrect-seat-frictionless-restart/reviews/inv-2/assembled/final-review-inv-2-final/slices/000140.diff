+/// The Herdr agent names `agent.start` submits for an agent of `kind` in `pane`, in order. Herdr names match
+/// `[a-z][a-z0-9_-]{0,31}` and are unique among live agents. First the sanitized pane label, else the kind;
+/// then, only after Herdr refuses the first as `agent_name_taken`, that name cut to fit plus `-<pane id>`.
+/// Pane ids are never reused within one server, so two unlabelled panes of one kind both start.
+pub fn agent_names(label: Option<&str>, kind: &str, pane: &HerdrPaneId) -> [String; 2] {
+    use herdr_threads::ports::{HERDR_AGENT_NAME_MAX, sanitize_agent_name};
+    let first = label
+        .and_then(sanitize_agent_name)
+        .or_else(|| sanitize_agent_name(kind))
+        .unwrap_or_else(|| "agent".to_owned());
+    let keep = HERDR_AGENT_NAME_MAX.saturating_sub(1 + pane.0.len());
+    let base = &first[..first.len().min(keep)];
+    let retry =
+        sanitize_agent_name(&format!("{base}-{}", pane.0)).unwrap_or_else(|| first.clone());
+    [first, retry]
+}
