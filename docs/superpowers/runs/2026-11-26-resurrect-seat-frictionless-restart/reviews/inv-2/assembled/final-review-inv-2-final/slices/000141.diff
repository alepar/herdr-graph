+    /// Herdr's rule: an agent name is unique among live agents. `name` is live when another pane that still
+    /// has an agent was started under it.
+    fn agent_name_live(&self, name: &str, except: &HerdrPaneId) -> bool {
+        self.workspaces
+            .iter()
+            .flat_map(|w| &w.tabs)
+            .flat_map(|t| &t.panes)
+            .any(|p| {
+                &p.id != except
+                    && p.agent.is_some()
+                    && self.agent_names.get(&p.id).map(String::as_str) == Some(name)
+            })
+    }
