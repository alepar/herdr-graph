+fn held_rows(fx: &Fx, now: Timestamp) -> Vec<serde_json::Value> {
+    crate::daemon::clone_status::clone_status_at(&view(fx), &fx.journal, now)["resurrect_held"]
+        .as_array()
+        .unwrap()
+        .clone()
+}
