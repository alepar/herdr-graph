+    assert_eq!(m["count"], 1);
+    assert_eq!(m["replace"], "none");
+    assert_eq!(m["pane"], pane.0.as_str());
+    assert!(m["first_at"].as_str().is_some());
+    assert!(matches!(
+        intent(&fx, &clone.id),
+        Some(SeatIntent::Restore {
+            threads_done: false,
+            last_refusal: Some(_),
+            ..
+        })
+    ));
+    assert_eq!(fx.threads.call_count("resurrect_seat"), 1);
