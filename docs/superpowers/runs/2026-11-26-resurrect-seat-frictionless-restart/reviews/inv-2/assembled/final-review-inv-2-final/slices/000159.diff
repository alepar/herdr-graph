+fn refused_meta_of(fx: &Fx, clone: &CloneId) -> Option<serde_json::Value> {
+    serde_json::from_str(
+        &fx.journal
+            .meta_get(&super::effects::resurrect_refused_key(clone))
+            .unwrap()?,
+    )
+    .ok()
+}
+
+fn threads_done(fx: &Fx, clone: &CloneId) -> bool {
+    matches!(
+        intent(fx, clone),
+        Some(SeatIntent::Restore {
+            threads_done: true,
+            ..
+        })
+    )
+}
