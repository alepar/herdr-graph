+    fx.threads.close_pane(&fx.seats, &seat_ref("seat-A"));
+    fx.clock
+        .advance(chrono::Duration::days(7) + chrono::Duration::seconds(1));
+    fx.threads.settle_windows();
+    let epoch = OpId::new();
+    write_restore(&fx, &clone.id, &epoch);
+    commit_seat_read(&fx, &clone.id, "seat-A").await;
