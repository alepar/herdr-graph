+fn first_refusal_at(fx: &Fx, clone: &CloneId) -> Timestamp {
+    chrono::DateTime::parse_from_rfc3339(
+        refused_meta_of(fx, clone).unwrap()["first_at"]
+            .as_str()
+            .unwrap(),
+    )
+    .unwrap()
+    .with_timezone(&chrono::Utc)
+}
