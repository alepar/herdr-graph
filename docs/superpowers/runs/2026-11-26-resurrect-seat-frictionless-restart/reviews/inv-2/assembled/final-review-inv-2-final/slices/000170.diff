+#[tokio::test(flavor = "multi_thread")]
+async fn resurrect_after_finalization_is_not_found() {
+    let Some(herdr) = tier5_herdr() else { return };
+    let daemon = tier5_daemon(
+        &herdr,
+        &[
+            ("HT_TEST_OBLIGATION_EXPIRY_MS", "500"),
