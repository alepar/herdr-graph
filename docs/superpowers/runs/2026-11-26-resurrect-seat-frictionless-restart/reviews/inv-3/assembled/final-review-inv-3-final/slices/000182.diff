+
+#[test]
+fn retired_fact_reads_legacy_without_keyed() {
+    use crate::model::clone::{SeatFact, SeatFactState};
+    let legacy: SeatFact = serde_json::from_value(serde_json::json!({
+        "seat": "s",
+        "state": "retired",
+        "reversible": true,
+        "read_at": "2026-10-02T12:00:00Z",
+    }))
+    .unwrap();
+    assert_eq!(
+        legacy.state,
+        SeatFactState::Retired {
+            reversible: true,
+            keyed: true,
+            retired_at: None,
+        }
+    );
+    let t = chrono::DateTime::from_timestamp_millis(5_000).unwrap();
+    let fact = SeatFact {
+        seat: "s".into(),
+        state: SeatFactState::Retired {
+            reversible: true,
+            keyed: false,
+            retired_at: Some(t),
+        },
+        read_at: t,
+    };
+    json_rt(&fact);
+    toml_rt(&fact);
+    assert!(
+        !serde_json::to_string(&SeatFactState::Retired {
+            reversible: false,
+            keyed: true,
+            retired_at: None
+        })
+        .unwrap()
+        .contains("retired_at")
+    );
+}
