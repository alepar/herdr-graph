+/// Journal meta: the `incarnation:changed_at` (RFC 3339) in which the first fresh `Unresolved` read of the
+/// clone's seat was seen. A later `Resolved` read in that incarnation is fresh, which opens the keyless start
+/// gate (spec §4). Never cleared; a new incarnation overwrites it.
+pub fn seat_unresolved_key(clone: &CloneId) -> String {
+    format!("seat_unresolved:{clone}")
+}
+
+/// Journal meta: `{"incarnation","reason"}`, written once when threads definitively refuses the restart rebind
+/// of `clone` in the incarnation that began at `incarnation` (RFC 3339 `changed_at`); the reason is the
+/// `SeatRestoreRefusal` in snake case. The rebind is not retried in that incarnation.
+pub fn rebind_refused_key(clone: &CloneId) -> String {
+    format!("rebind_refused:{clone}")
+}
+
+/// The reason recorded in `rebind_refused:<clone>` when it names the incarnation that began at `changed_at`.
+pub fn rebind_refused_in(
+    journal: &Journal,
+    clone: &CloneId,
+    changed_at: Timestamp,
+) -> Option<String> {
+    let raw = journal
+        .meta_get(&rebind_refused_key(clone))
+        .ok()
+        .flatten()?;
+    let v: serde_json::Value = serde_json::from_str(&raw).ok()?;
+    (v["incarnation"].as_str() == Some(changed_at.to_rfc3339().as_str()))
+        .then(|| v["reason"].as_str().unwrap_or_default().to_owned())
+}
+
+/// Whether `seat_unresolved:<clone>` names the incarnation that began at `changed_at`.
+pub fn seat_unresolved_in(journal: &Journal, clone: &CloneId, changed_at: Timestamp) -> bool {
+    journal
+        .meta_get(&seat_unresolved_key(clone))
+        .ok()
+        .flatten()
+        .is_some_and(|raw| raw == changed_at.to_rfc3339())
+}
