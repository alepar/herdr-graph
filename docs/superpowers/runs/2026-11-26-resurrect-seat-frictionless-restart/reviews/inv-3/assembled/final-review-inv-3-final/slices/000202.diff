+
+        // -------------------------------------------------------------------------------------
+        // resurrect on undo and frictionless Herdr restart (hg-lnw.12): the composed daemon with the
+        // fake threads 3.6.0 seat-lifecycle model on
+        // -------------------------------------------------------------------------------------
+
+        /// A composed daemon whose fake threads runs the 3.5.0/3.6.0 seat-lifecycle model on the daemon's seat
+        /// view and manual clock (reversible keyless closes, the 24 h and 7 d windows, ResurrectSeat, U2).
+        async fn model_daemon(root: &Path) -> Daemon {
+            let fakes = Fakes::new();
+            fakes
+                .threads
+                .enable_resurrect(fakes.seat_view.clone(), fakes.clock.clone());
+            let threads = fakes.threads.clone();
+            Daemon::start_with(root, fakes, threads).await
+        }
+
+        /// A legacy workspace `legacy` with tab `worker`: one claude pane running session `session` (threads
+        /// resolves it to `seat`) beside a plain pane, adopted as teamspace `legacy` and seat `worker`. Returns
+        /// the keyless clone, its pane and the tab.
+        async fn adopted_keyless(
+            d: &Daemon,
+            seat: &str,
+            session: &str,
+        ) -> (CloneRecord, HerdrPaneId, herdr_graph::model::HerdrTabId) {
+            use herdr_graph::ports::herdr::{CreateTab, CreateWorkspace};
+            let ws = d
+                .fakes
+                .herdr
+                .create_workspace(CreateWorkspace {
+                    label: "legacy".into(),
+                    cwd: PathBuf::from("/"),
+                    env: vec![],
+                })
+                .await
+                .unwrap()
+                .workspace
+                .unwrap();
+            let tab = d
+                .fakes
+                .herdr
+                .create_tab(CreateTab {
+                    workspace: ws,
+                    label: "worker".into(),
+                    cwd: PathBuf::from("/"),
+                    env: vec![],
+                })
+                .await
+                .unwrap();
+            let (tab, pane) = (tab.tab.unwrap(), tab.pane.unwrap());
+            d.fakes.herdr.add_user_pane(&tab, "notes");
+            d.fakes
+                .herdr
+                .set_agent(&pane, agent("claude", AgentSession::Id(session.into())));
+            threads_resolves(d, &pane, seat);
+            d.committed(&["teamspace", "adopt", "legacy"]).await;
+            d.committed(&["seat", "adopt", "worker", "--harness", "claude"])
+                .await;
+            eventually("the adopted keyless clone on its seat and pane", || {
+                d.clones_of("worker").first().is_some_and(|c| {
+                    c.keyless
+                        && c.threads_seat.as_deref() == Some(seat)
+                        && c.runtime.bound.as_ref().and_then(|b| b.pane_id.as_ref()) == Some(&pane)
+                        && c.seat_fact.as_ref().is_some_and(|f| {
+                            f.seat == seat
+                                && f.state == SeatFactState::Resolved { pane: pane.clone() }
+                        })
+                })
+            })
+            .await;
+            (d.clone_of("worker"), pane, tab)
+        }
+
+        /// The act of the observed closure of a pane, from `undo.list`.
+        async fn closure_act(d: &Daemon) -> String {
+            let list = d.call("undo.list", json!({})).await.unwrap();
+            list["candidates"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .find(|c| c["summary"].as_str().is_some_and(|s| s.contains("closure")))
+                .unwrap_or_else(|| panic!("no closure to undo: {list}"))["act"]
+                .as_str()
+                .unwrap()
+                .to_owned()
+        }
+
+        /// `undo <act>` through the daemon: returns the plan preview text and admits the undo.
+        async fn undo(d: &Daemon, act: &str) -> String {
+            let plan = d
+                .call("plan.create", json!({ "words": ["undo", act] }))
+                .await
+                .unwrap();
+            let r = d
+                .call(
+                    "undo.apply",
+                    json!({ "plan": plan["plan_id"], "confirm": plan["hash"], "mode": "relay" }),
+                )
+                .await
+                .unwrap();
+            assert_eq!(r["state"], "admitted", "{r}");
+            plan.to_string()
+        }
+
+        /// The keyless close-then-undo window under test, by the age of the threads retirement at the undo.
+        #[derive(Clone, Copy, Debug, PartialEq)]
+        enum Window {
+            /// Before `retired_at + 24h`: everything returns.
+            Fresh,
+            /// 24 h to 7 d: memberships return, ordinary pending invitations settled.
+            Settled,
+            /// After 7 d: the retirement is final, fresh-seat succession.
+            Final,
+        }
+
+        /// Spec §3 end to end through the composed daemon: an adopted keyless clone with an external accepted
+        /// membership and an ordinary pending invitation is closed by the user (threads retires its seat
+        /// reversibly), the clock moves into `w`, and `undo` brings it back. Inside 7 d the same seat is
+        /// resurrected onto the reopened pane (external membership kept, invitation re-issued after 24 h) and
+        /// the restore launch resumes the last session; after 7 d the clone succeeds onto the reopened pane's
+        /// fresh seat. The undo preview names the window.
+        async fn keyless_close_then_undo(w: Window) {
+            let (_dir, root) = new_instance();
+            // As flow 5: the node manager's observed closure is kept for a Restore instead of retiring.
+            crate::support::node_manager_opt_out(&root);
+            let d = model_daemon(&root).await;
+            let (clone, pane, _tab) = adopted_keyless(&d, "th-A", "adopt-1").await;
+            // A thread graph does not manage, which the seat accepted, and an ordinary invitation graph
+            // does not own: what threads keeps (memberships) and settles (pending ordinary) by window.
+            let ext = ThreadRef("ext-chat".into());
+            let pending = ThreadRef("ext-pending".into());
+            d.fakes.threads.add_thread(&ext.0, "external chat");
+            d.fakes.threads.add_thread(&pending.0, "external invite");
+            for t in [&ext, &pending] {
+                d.fakes
+                    .threads
+                    .invite(
+                        t,
+                        &tseat("th-A"),
+                        herdr_graph::model::clone::InviteConstraint::Ordinary,
+                        &OpKey(format!("ext-{}", t.0)),
+                    )
+                    .await
+                    .unwrap();
+            }
+            d.fakes.threads.accept(&ext, &tseat("th-A"));
+
+            // The user closes the agent pane: threads retires the keyless seat reversibly (3.5.0) and graph
+            // retires the clone.
+            d.fakes.herdr.set_agent(&pane, None);
+            d.fakes.herdr.user_close_pane(&pane);
+            let kind = d
+                .fakes
+                .threads
+                .close_pane(&d.fakes.seat_view, &tseat("th-A"));
+            assert_eq!(kind, RetirementKind::Reversible);
+            eventually("the clone retires on a reversible keyless fact", || {
+                let c = clone_by_id(&d, "worker", &clone.id);
+                c.lifecycle == CloneLifecycle::Retired
+                    && c.seat_fact.as_ref().is_some_and(|f| {
+                        matches!(
+                            f.state,
+                            SeatFactState::Retired {
+                                reversible: true,
+                                keyed: false,
+                                ..
+                            }
+                        )
+                    })
+            })
+            .await;
+
+            let hours = match w {
+                Window::Fresh => 1,
+                Window::Settled => 30,
+                Window::Final => 8 * 24,
+            };
+            d.fakes.clock.advance(chrono::Duration::hours(hours));
+            d.fakes.threads.settle_windows();
+            // A retired clone's fact is not re-read until the undo writes its Restore: the preview names the
+            // window from the recorded `retired_at`, the want from the fact read after the undo.
+            d.fakes.herdr.clear_calls();
+            let preview = undo(&d, &closure_act(&d).await).await;
+            let named = match w {
+                Window::Fresh => "comes back with everything",
+                Window::Settled => "comes back with its memberships and history",
+                Window::Final => "is final; the pane gets a fresh threads seat",
+            };
+            assert!(
+                preview.contains(named),
+                "the undo preview names the {w:?} window ({named:?}): {preview}"
+            );
+
+            eventually("the clone is active in a reopened pane", || {
+                let c = clone_by_id(&d, "worker", &clone.id);
+                c.lifecycle == CloneLifecycle::Active
+                    && c.runtime
+                        .bound
+                        .as_ref()
+                        .and_then(|b| b.pane_id.as_ref())
+                        .is_some_and(|p| p != &pane)
+            })
+            .await;
+            let reopened = clone_by_id(&d, "worker", &clone.id)
+                .runtime
+                .bound
+                .and_then(|b| b.pane_id)
+                .unwrap();
+
+            if w == Window::Final {
+                assert_eq!(d.fakes.threads.call_count("resurrect_seat"), 0);
+                threads_resolves(&d, &reopened, "th-B");
+                eventually("the seat succeeds to the fresh seat", || {
+                    clone_by_id(&d, "worker", &clone.id).threads_seat.as_deref() == Some("th-B")
+                })
+                .await;
+                let now = clone_by_id(&d, "worker", &clone.id);
+                assert_eq!(now.threads_seat_history, vec!["th-A".to_owned()]);
+                assert!(d.fakes.threads.member(&ext, &tseat("th-B")).is_none());
+                d.stop().await;
+                return;
+            }
+
+            eventually("the original seat is resurrected and the restore launched", || {
+                let c = clone_by_id(&d, "worker", &clone.id);
+                matches!(c.seat_intent, Some(SeatIntent::Restore { ref seat, threads_done: true, .. }) if seat == "th-A")
+                    && !start_calls(&d).is_empty()
+            })
+            .await;
+            assert_eq!(
+                d.fakes.threads.lifecycle_calls("resurrect_seat"),
+                vec!["th-A"]
+            );
+            assert_eq!(d.fakes.threads.call_count("unretire_seat"), 0);
+            assert_eq!(
+                d.fakes.seat_view.status(&tseat("th-A")),
+                Some(SeatStatus::Resolved {
+                    pane: reopened.clone()
+                })
+            );
+            let now = clone_by_id(&d, "worker", &clone.id);
+            assert_eq!(now.threads_seat.as_deref(), Some("th-A"));
+            assert!(now.threads_seat_history.is_empty(), "no succession");
+            let starts = start_calls(&d);
+            assert_eq!(starts.len(), 1, "{starts:?}");
+            assert_eq!(starts[0].pane, reopened);
+            assert_eq!(starts[0].args, ["--resume", "adopt-1"]);
+            assert_eq!(
+                d.fakes
+                    .threads
+                    .member(&ext, &tseat("th-A"))
+                    .map(|m| m.state),
+                Some(herdr_graph::model::clone::InvitationState::Accepted),
+                "the external membership returns"
+            );
+            assert_eq!(
+                d.fakes.threads.member(&pending, &tseat("th-A")).is_some(),
+                w == Window::Fresh,
+                "an ordinary invitation others sent returns only before 24 h"
+            );
+            d.stop().await;
+        }
+
+        /// Spec §3 row 1 end to end: a created (keyed) claude clone closed by the user retires its seat
+        /// reversibly because its continuity key is bound; `undo` unretires the same seat (no ResurrectSeat, no
+        /// succession), keeps the accepted external membership, and the restore launch resumes the session.
+        #[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+        async fn sweep_keyed_close_then_undo_unretires_the_same_seat() {
+            let (_dir, root) = new_instance();
+            crate::support::node_manager_opt_out(&root);
+            let d = model_daemon(&root).await;
+            // A second clone of the seat is the one closed: closing the only clone's pane would make the
+            // active seat start a replacement clone (as flow 5).
+            start_seat(&d, "worker", "claude").await;
+            d.committed(&["clone", "add", "worker"]).await;
+            eventually("both clones' panes", || {
+                let cs = d.clones_of("worker");
+                cs.len() == 2 && cs.iter().all(|c| c.runtime.bound.is_some())
+            })
+            .await;
+            let first = d.pane("worker");
+            let clone = d
+                .clones_of("worker")
+                .into_iter()
+                .find(|c| c.runtime.bound.as_ref().and_then(|b| b.pane_id.clone()) != first)
+                .unwrap();
+            let pane = clone
+                .runtime
+                .bound
+                .as_ref()
+                .and_then(|b| b.pane_id.clone())
+                .unwrap();
+            threads_resolves(&d, &pane, "th-A");
+            d.fakes
+                .herdr
+                .set_agent(&pane, agent("claude", AgentSession::Id("sess-1".into())));
+            eventually("seated, keyed on th-A, with its session", || {
+                let c = clone_by_id(&d, "worker", &clone.id);
+                c.threads_seat.as_deref() == Some("th-A")
+                    && c.occupant.is_some()
+                    && c.key_reservation.is_some_and(|k| {
+                        d.fakes.threads.key_binding(&k.key).as_deref() == Some("th-A")
+                    })
+            })
+            .await;
+            let ext = ThreadRef("ext-chat".into());
+            d.fakes.threads.add_thread(&ext.0, "external chat");
+            d.fakes
+                .threads
+                .invite(
+                    &ext,
+                    &tseat("th-A"),
+                    herdr_graph::model::clone::InviteConstraint::Ordinary,
+                    &OpKey("ext".into()),
+                )
+                .await
+                .unwrap();
+            d.fakes.threads.accept(&ext, &tseat("th-A"));
+
+            d.fakes.herdr.set_agent(&pane, None);
+            d.fakes.herdr.user_close_pane(&pane);
+            let kind = d
+                .fakes
+                .threads
+                .close_pane(&d.fakes.seat_view, &tseat("th-A"));
+            assert_eq!(kind, RetirementKind::Reversible);
+            eventually("the clone retires", || {
+                clone_by_id(&d, "worker", &clone.id).lifecycle == CloneLifecycle::Retired
+            })
+            .await;
+            d.fakes.herdr.clear_calls();
+            undo(&d, &closure_act(&d).await).await;
+            eventually("the same seat is unretired and the restore launched", || {
+                let c = clone_by_id(&d, "worker", &clone.id);
+                matches!(c.seat_intent, Some(SeatIntent::Restore { ref seat, threads_done: true, .. }) if seat == "th-A")
+                    && c.runtime.bound.as_ref().and_then(|b| b.pane_id.as_ref()).is_some_and(|p| p != &pane)
+            })
+            .await;
+            let reopened = clone_by_id(&d, "worker", &clone.id)
+                .runtime
+                .bound
+                .and_then(|b| b.pane_id)
+                .unwrap();
+            let on_reopened = || {
+                start_calls(&d)
+                    .into_iter()
+                    .filter(|s| s.pane == reopened)
+                    .collect::<Vec<_>>()
+            };
+            eventually("the restore launch", || !on_reopened().is_empty()).await;
+            assert_eq!(
+                d.fakes.threads.lifecycle_calls("unretire_seat"),
+                vec!["th-A"]
+            );
+            assert_eq!(d.fakes.threads.call_count("resurrect_seat"), 0);
+            let now = clone_by_id(&d, "worker", &clone.id);
+            assert_eq!(now.threads_seat.as_deref(), Some("th-A"));
+            assert!(now.threads_seat_history.is_empty(), "no succession");
+            tokio::time::sleep(Duration::from_millis(300)).await;
+            let starts = on_reopened();
+            assert_eq!(starts.len(), 1, "{starts:?}");
+            assert_eq!(starts[0].args, ["--resume", "sess-1"]);
+            assert_eq!(
+                d.fakes
+                    .threads
+                    .member(&ext, &tseat("th-A"))
+                    .map(|m| m.state),
+                Some(herdr_graph::model::clone::InvitationState::Accepted)
+            );
+            d.stop().await;
+        }
+
+        /// Spec §4 end to end through the composed daemon: a Herdr cold restart (pane ids kept) with a created
+        /// keyed claude seat, an adopted keyless claude seat and a graph-created shell seat, each holding a
+        /// session-less or ended agent, and threads holding every seat for the restart. With no operator step,
+        /// graph rebinds each held seat onto its own pane (U2, one op key per incarnation), nothing launches in
+        /// the shell pane, both agent seats resume their last session once the 90 s grace ends, and no
+        /// `restart_held` row remains.
+        #[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+        async fn sweep_cold_restart_rebinds_every_seat_kind() {
+            let (_dir, root) = new_instance();
+            crate::support::node_manager_opt_out(&root);
+            let d = model_daemon(&root).await;
+            let keyed = seated_and_invited(&d, "kc", "claude", "th-K").await;
+            session_starts(&d, "kc", &keyed, "kc-1").await;
+            session_ends(&d, "kc", &keyed).await;
+            d.committed(&[
+                "seat",
+                "create",
+                "sh",
+                "--teamspace",
+                "t",
+                "--active",
+                "--harness",
+                "shell",
+            ])
+            .await;
+            eventually("the shell clone's pane", || d.pane("sh").is_some()).await;
+            let shell = d.pane("sh").unwrap();
+            threads_resolves(&d, &shell, "th-S");
+            eventually("the shell seat is seated", || {
+                seat_of(&d, "sh").as_deref() == Some("th-S")
+            })
+            .await;
+            let (_, adopted, tab) = adopted_keyless(&d, "th-A", "adopt-1").await;
+            session_ends(&d, "worker", &adopted).await;
+            eventually("every seat fact is Resolved on its pane", || {
+                [("kc", &keyed), ("sh", &shell), ("worker", &adopted)]
+                    .iter()
+                    .all(|(n, p)| {
+                        d.clone_of(n).seat_fact.is_some_and(|f| {
+                            f.state == SeatFactState::Resolved { pane: (*p).clone() }
+                        })
+                    })
+            })
+            .await;
+            d.fakes.herdr.clear_calls();
+
+            herdr_restarts_keeping_pane_ids(&d, &root, true, &keyed).await;
+            for (seat, pane) in [("th-K", &keyed), ("th-S", &shell), ("th-A", &adopted)] {
+                d.fakes.threads.hold_for_restart(&tseat(seat), pane);
+            }
+            eventually("graph rebinds every held seat onto its own pane", || {
+                [("th-K", &keyed), ("th-S", &shell), ("th-A", &adopted)]
+                    .iter()
+                    .all(|(s, p)| {
+                        d.fakes.seat_view.status(&tseat(s))
+                            == Some(SeatStatus::Resolved { pane: (*p).clone() })
+                    })
+            })
+            .await;
+            let mut rebound = d.fakes.threads.lifecycle_calls("rebind_held_seat");
+            rebound.sort();
+            rebound.dedup();
+            assert_eq!(rebound, ["th-A", "th-K", "th-S"]);
+            assert!(
+                d.fakes
+                    .threads
+                    .lifecycle_ops("rebind_held_seat")
+                    .iter()
+                    .all(|op| op.0.starts_with("rebind:")),
+                "{:?}",
+                d.fakes.threads.lifecycle_ops("rebind_held_seat")
+            );
+            assert!(start_calls(&d).is_empty(), "resumes wait out the grace");
+
+            d.fakes.clock.advance(chrono::Duration::seconds(91));
+            poke(&d, &tab);
+            eventually("both agent seats resume", || start_calls(&d).len() >= 2).await;
+            tokio::time::sleep(Duration::from_millis(300)).await;
+            let mut starts: Vec<_> = start_calls(&d)
+                .into_iter()
+                .map(|s| (s.pane, s.args))
+                .collect();
+            starts.sort();
+            let mut want = vec![
+                (
+                    keyed.clone(),
+                    vec!["--resume".to_owned(), "kc-1".to_owned()],
+                ),
+                (
+                    adopted.clone(),
+                    vec!["--resume".to_owned(), "adopt-1".to_owned()],
+                ),
+            ];
+            want.sort();
+            assert_eq!(starts, want, "nothing launches in the shell pane");
+            for (n, s) in [("kc", "th-K"), ("sh", "th-S"), ("worker", "th-A")] {
+                assert_eq!(seat_of(&d, n).as_deref(), Some(s), "{n} keeps its seat");
+            }
+            let status = d.call("status", json!({})).await.unwrap();
+            assert_eq!(
+                status["components"]["clones"]["restart_held"],
+                json!([]),
+                "{status}"
+            );
+            d.stop().await;
+        }
+
+        #[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+        async fn sweep_keyless_close_then_undo_before_24h_resurrects() {
+            keyless_close_then_undo(Window::Fresh).await;
+        }
+
+        #[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+        async fn sweep_keyless_close_then_undo_between_24h_and_7d_resurrects() {
+            keyless_close_then_undo(Window::Settled).await;
+        }
+
+        #[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+        async fn sweep_keyless_close_then_undo_after_7d_takes_a_fresh_seat() {
+            keyless_close_then_undo(Window::Final).await;
+        }
     }
 }
 
