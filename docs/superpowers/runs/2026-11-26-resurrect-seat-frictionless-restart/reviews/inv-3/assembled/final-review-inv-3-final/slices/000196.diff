+/// An older daemon's refusal of the v4 registration is a named error with the upgrade step on every call,
+/// never a fallback to v3; the restore calls read it as a definitive `Unsupported` refusal.
+#[tokio::test]
+async fn v4_registration_refused_is_a_named_error() {
+    let dir = tempfile::tempdir().unwrap();
+    let old = old_daemon(dir.path());
+    match old
+        .ensure_thread(ChannelScope::Seat, "t", &OpKey("ensure:st_OLD".into()))
+        .await
+    {
+        Err(ThreadsError::Rejected(m)) => assert_eq!(
+            m,
+            "herdr-threads daemon refused service_session_v4 (unsupported service capability); \
+             upgrade the herdr-threads daemon to >= 3.6.0"
+        ),
+        other => panic!("expected the named v4 refusal, got {other:?}"),
+    }
+    let pane = HerdrPaneId("w1:p1".into());
+    assert_eq!(
+        old.rebind_held_seat(&seat("s"), &pane, &OpKey("rebind:old".into()))
+            .await,
+        SeatRestoreOutcome::refused(SeatRestoreRefusal::Unsupported)
+    );
+    assert_eq!(
+        old.resurrect_seat(&seat("s"), &pane, None, &OpKey("resurrect:old".into()))
+            .await,
+        SeatRestoreOutcome::refused(SeatRestoreRefusal::Unsupported)
+    );
+}
