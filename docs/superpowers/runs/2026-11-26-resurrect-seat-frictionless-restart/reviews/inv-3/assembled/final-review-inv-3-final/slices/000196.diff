+/// Every answer threads can give a `ResurrectSeat` maps to one port outcome, with the transient/definitive split
+/// of the resurrect and rebind executors.
+#[test]
+fn restore_outcome_maps_every_variant() {
+    use super::adapter::{MutateError, restore_outcome};
+    use SeatRestoreRefusal as R;
+    let api = |code: ErrorCode, pending: bool| {
+        Err(MutateError::Api {
+            error: api_error(code),
+            pending,
+        })
+    };
+    let s = SeatId::new("s");
+    assert_eq!(
+        restore_outcome(Ok(ServiceResult::SeatResurrected(s.clone()))),
+        SeatRestoreOutcome::Done
+    );
+    assert_eq!(
+        restore_outcome(Ok(ServiceResult::SeatAlreadyResolved(s))),
+        SeatRestoreOutcome::AlreadyResolved
+    );
+    assert_eq!(
+        restore_outcome(Ok(ServiceResult::TopicChanged(ManagedThread {
+            thread: ThreadId::new("t"),
+            owner: ServiceAuthorId::new("graph"),
+            archived: false,
+        }))),
+        SeatRestoreOutcome::refused(R::InvalidRequest)
+    );
+    let table = [
+        (ErrorCode::NotFound, R::NotFound, false),
+        (ErrorCode::Unauthorized, R::Unauthorized, false),
+        (ErrorCode::CallerUnverified, R::Unauthorized, false),
+        (ErrorCode::TargetAlreadyOwned, R::TargetAlreadyOwned, false),
+        (ErrorCode::InvalidRequest, R::InvalidRequest, false),
+        (
+            ErrorCode::OperationPayloadMismatch,
+            R::InvalidRequest,
+            false,
+        ),
+        (ErrorCode::StoreCorrupt, R::InvalidRequest, false),
+        (ErrorCode::Unsupported, R::Unsupported, false),
+        (ErrorCode::UnsupportedHarness, R::Unsupported, false),
+        (ErrorCode::InstanceMismatch, R::InstanceMismatch, false),
+        (ErrorCode::ServiceBusy, R::ServiceBusy, true),
+        (ErrorCode::StoreBusy, R::ServiceBusy, true),
+        (
+            ErrorCode::StaleHostObservation,
+            R::StaleHostObservation,
+            true,
+        ),
+        (ErrorCode::UnknownOutcome, R::OutcomeUnknown, true),
+        (ErrorCode::HostUnavailable, R::Unreachable, true),
+        (ErrorCode::TransportDenied, R::Unreachable, true),
+        (ErrorCode::DeadlineExceeded, R::Unreachable, true),
+        (ErrorCode::Cancelled, R::Unreachable, true),
+        (ErrorCode::StaleServiceGeneration, R::Unreachable, true),
+        (ErrorCode::ServiceNotRegistered, R::Unreachable, true),
+        (ErrorCode::DaemonBootChanged, R::Unreachable, true),
+    ];
+    for (code, reason, retryable) in table {
+        let got = restore_outcome(api(code.clone(), false));
+        assert_eq!(got, SeatRestoreOutcome::refused(reason), "{code:?}");
+        assert_eq!(reason.retryable(), retryable, "{code:?}");
+    }
+    // An intent left pending: busy stays busy, anything else is an unknown outcome (replayed).
+    assert_eq!(
+        restore_outcome(api(ErrorCode::ServiceBusy, true)),
+        SeatRestoreOutcome::refused(R::ServiceBusy)
+    );
+    for code in [
+        ErrorCode::HostUnavailable,
+        ErrorCode::UnknownOutcome,
+        ErrorCode::NotFound,
+    ] {
+        assert_eq!(
+            restore_outcome(api(code.clone(), true)),
+            SeatRestoreOutcome::refused(R::OutcomeUnknown),
+            "{code:?}"
+        );
+    }
+    // Local failures: the v4 registration refusal (threads' answer to the registration) is Unsupported; the
+    // others keep the transport mapping.
+    let local = |e| restore_outcome(Err(MutateError::Local(e)));
+    assert_eq!(
+        local(super::adapter::level_refused(
+            "unsupported service capability"
+        )),
+        SeatRestoreOutcome::refused(R::Unsupported)
+    );
+    assert!(!R::Unsupported.retryable());
+    assert_eq!(
+        local(ThreadsError::Disconnected("gone".into())),
+        SeatRestoreOutcome::refused(R::Unreachable)
+    );
+    // A graph-local failure (intent journal, namespace guard, host claim) is `Disconnected`: retryable.
+    for m in [
+        "intent journal: permission denied",
+        "graph-local: stale external call snapshot; retry from the current committed namespace",
+        "graph-local: host claim: no such file or directory",
+    ] {
+        assert_eq!(
+            local(ThreadsError::Disconnected(m.into())),
+            SeatRestoreOutcome::Refused {
+                reason: R::Unreachable,
+                retryable: true
+            },
+            "{m}"
+        );
+    }
+    assert_eq!(
+        local(ThreadsError::ServiceBusy),
+        SeatRestoreOutcome::refused(R::ServiceBusy)
+    );
+    // `Rejected` carries only threads' own answers: definitive.
+    assert_eq!(
+        local(ThreadsError::Rejected("other".into())),
+        SeatRestoreOutcome::refused(R::InvalidRequest)
+    );
+    assert!(!R::InvalidRequest.retryable());
+    // The transport-error mapping the lazy production port uses before any call reaches threads.
+    assert_eq!(
+        SeatRestoreOutcome::from_error(&ThreadsError::Disconnected("graph-local: x".into())),
+        SeatRestoreOutcome::Refused {
+            reason: R::Unreachable,
+            retryable: true
+        }
+    );
+    assert_eq!(
+        SeatRestoreOutcome::from_error(&ThreadsError::Rejected("threads said no".into())),
+        SeatRestoreOutcome::Refused {
+            reason: R::InvalidRequest,
+            retryable: false
+        }
+    );
+}
