+/// A threads daemon that refuses every registration as an unsupported capability (one older than 3.5.0, which
+/// does not serve `service_session_v4`).
+fn old_daemon(dir: &std::path::Path) -> ServiceThreads {
+    let socket = dir.join("old.sock");
+    let listener = tokio::net::UnixListener::bind(&socket).unwrap();
+    tokio::spawn(async move {
+        loop {
+            let Ok((mut s, _)) = listener.accept().await else {
+                return;
+            };
+            tokio::spawn(async move {
+                let Ok(bytes) = read_frame(&mut s).await else {
+                    return;
+                };
+                let v: serde_json::Value = serde_json::from_slice(&bytes).unwrap();
+                let response = json!({
+                    "version": PROTOCOL_VERSION, "request_id": v["request_id"], "instance": v["expected_instance"],
+                    "daemon_boot": BOOT,
+                    "result": { "Err": { "code": "unsupported", "detail": "unsupported service capability",
+                                          "restart_argv": null, "required_minimum_bytes": null } }
+                });
+                let _ = write_frame(&mut s, &serde_json::to_vec(&response).unwrap()).await;
+            });
+        }
+    });
+    ServiceThreads::with_system_clock(
+        socket,
+        dir.join("i/intents"),
+        herdr_threads::node::NodeUuid::from_bytes(*uuid::Uuid::new_v4().as_bytes()),
+        host(),
+    )
+    .unwrap()
+}
