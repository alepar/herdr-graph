+/// A refusal is never replayed from the intent journal: a retry under the same key (a `NotFound` re-read or a
+/// stale observation) reaches threads again and gets a fresh decision. A busy answer stays pending and is
+/// replayed with its original envelope.
+#[tokio::test]
+async fn restore_retry_under_the_same_key_is_a_fresh_decision() {
+    let fx = fx().await;
+    let pane = HerdrPaneId("w1:p1".into());
+    let key = OpKey("resurrect:c1:e1:none:0".into());
+    {
+        let mut answers = fx.svc.resurrect_answers.lock().unwrap();
+        answers.push_back(Err(api_error(ErrorCode::NotFound)));
+        answers.push_back(Err(api_error(ErrorCode::StaleHostObservation)));
+        answers.push_back(Err(api_error(ErrorCode::ServiceBusy)));
+    }
+    let s = seat("s");
+    let call = || fx.threads.resurrect_seat(&s, &pane, None, &key);
+    assert_eq!(
+        call().await,
+        SeatRestoreOutcome::refused(SeatRestoreRefusal::NotFound)
+    );
+    assert_eq!(
+        call().await,
+        SeatRestoreOutcome::refused(SeatRestoreRefusal::StaleHostObservation)
+    );
+    assert_eq!(
+        call().await,
+        SeatRestoreOutcome::refused(SeatRestoreRefusal::ServiceBusy)
+    );
+    assert_eq!(call().await, SeatRestoreOutcome::Done);
+    let seen = fx.svc.mutations.lock().unwrap().clone();
+    assert_eq!(seen.len(), 4, "every retry reached threads: {seen:?}");
+    assert!(seen.iter().all(|(k, _)| k == "resurrect:c1:e1:none:0"));
+    assert_eq!(
+        seen[2], seen[3],
+        "the busy intent is replayed with its original envelope"
+    );
+    assert_ne!(seen[0].1, seen[1].1, "a refused intent is not replayed");
+}
