+/// The `restart held` check: seats still held by threads after a Herdr restart (the `clones.restart_held` rows).
+/// A `[WARN]` per spec §4.5 naming each seat, its pane, why, and the operator remedy; `None` when no seat is held.
+fn restart_held_check(clones: Option<&Value>) -> Option<Check> {
+    let rows = clones?["restart_held"].as_array()?;
+    if rows.is_empty() {
+        return None;
+    }
+    let items: Vec<String> = rows
+        .iter()
+        .map(|r| {
+            format!(
+                "{} seat {} on pane {}: {}; {}",
+                r["name"].as_str().unwrap_or("?"),
+                r["seat"].as_str().unwrap_or("?"),
+                r["pane"].as_str().unwrap_or("unknown"),
+                r["reason"].as_str().unwrap_or("?"),
+                r["remedy"].as_str().unwrap_or("?"),
+            )
+        })
+        .collect();
+    Some(warn_check("restart held", capped(&items)))
+}
+
+/// The `resurrect held` finding: clones whose seat threads refused to resurrect (the `clones` component's
+/// `resurrect_held` rows). None when there are none.
+fn resurrect_held_check(clones: Option<&Value>) -> Option<Check> {
+    let rows = clones?["resurrect_held"].as_array()?;
+    if rows.is_empty() {
+        return None;
+    }
+    let items: Vec<String> = rows
+        .iter()
+        .map(|r| {
+            format!(
+                "{} seat {} on pane {}: {}; {}",
+                r["name"].as_str().unwrap_or("?"),
+                r["seat"].as_str().unwrap_or("?"),
+                r["pane"].as_str().unwrap_or("?"),
+                r["reason"].as_str().unwrap_or("?"),
+                r["remedy"].as_str().unwrap_or("")
+            )
+        })
+        .collect();
+    Some(warn_check("resurrect held", capped(&items)))
+}
