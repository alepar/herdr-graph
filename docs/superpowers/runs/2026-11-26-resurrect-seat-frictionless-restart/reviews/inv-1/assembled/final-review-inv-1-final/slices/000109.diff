+/// What an undo brings back of a retired clone's threads seat, named by the window it is in (spec §3), or None
+/// when the clone holds no threads seat or is keyed (a keyed seat's retirement is reversible without a window).
+/// Reads the committed `seat_fact` (the retire-time read) and `c.retired.at`; the action itself follows the fact
+/// at execution, so a close threads never reported says so.
+pub(crate) fn seat_window_note(c: &CloneRecord, now: Timestamp) -> Option<String> {
+    use crate::model::clone::SeatFactState as F;
+    let seat = c.threads_seat.as_ref()?;
+    let fact = c.seat_fact.as_ref().filter(|f| &f.seat == seat);
+    let name = &c.name;
+    let (retired_at, suffix) = match fact.map(|f| &f.state) {
+        Some(F::Retired { keyed: true, .. }) => return None,
+        None if !c.keyless => return None,
+        Some(F::Retired {
+            reversible: true,
+            retired_at,
+            ..
+        }) => (retired_at.or(c.retired.as_ref().map(|r| r.at)), ""),
+        Some(F::Retired {
+            reversible: false, ..
+        }) => (None, ""),
+        None => (
+            c.retired.as_ref().map(|r| r.at),
+            " if threads reports the close reversible",
+        ),
+        // Not retired (or conflicting) at the read: nothing to say about a window.
+        Some(_) => return None,
+    };
+    let age = retired_at.map(|at| now - at);
+    Some(match age {
+        Some(age) if age < KEYLESS_OBLIGATIONS_SETTLE_AFTER => format!(
+            "clone {name}: threads seat {seat} comes back with everything: memberships, history, pending ACK receipts and invitations (closed less than 24 h ago){suffix}"
+        ),
+        Some(age) if age < KEYLESS_REVERSIBLE_FOR => format!(
+            "clone {name}: threads seat {seat} comes back with its memberships and history; ACK receipts and ordinary invitations owed to it settled at 24 h, and graph re-issues its own seat-wide invitations{suffix}"
+        ),
+        _ => format!(
+            "clone {name}: the closed threads seat {seat} is final; the pane gets a fresh threads seat, graph channels are re-invited, and memberships graph does not own are lost"
+        ),
+    })
+}
