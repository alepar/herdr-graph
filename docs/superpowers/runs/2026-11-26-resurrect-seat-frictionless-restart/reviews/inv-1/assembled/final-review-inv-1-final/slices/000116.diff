+/// `env_clear()` + `env` + `current_dir(root)`: [`PrivateHerdr::command`] for a caller that holds copies of a
+/// private Herdr's root and env rather than a borrow (so the Herdr can be restarted meanwhile).
+pub fn private_command(root: &Path, env: &[(String, String)], program: &Path) -> Command {
+    let mut c = Command::new(program);
+    c.env_clear().envs(env.iter().cloned()).current_dir(root);
+    c
