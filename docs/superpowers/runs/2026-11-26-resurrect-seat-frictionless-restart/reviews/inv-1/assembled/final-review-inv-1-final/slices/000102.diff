+/// The service-session level graph registers: `service_session_v4` (`ResurrectSeat` and the held-seat
+/// rebind). A daemon that does not serve it refuses the registration; there is no fallback to v3.
+pub(crate) const GRAPH_SERVICE_LEVEL: ServiceSessionLevel = ServiceSessionLevel::V4;
+
+/// The named registration error for a daemon that does not serve `GRAPH_SERVICE_LEVEL` (older than 3.6.0).
+/// The doctor's `threads` check keys its upgrade step on the capability name in it.
+pub(crate) fn level_refused(detail: &str) -> ThreadsError {
+    ThreadsError::Rejected(format!(
+        "herdr-threads daemon refused {} ({detail}); upgrade the herdr-threads daemon to >= 3.6.0",
+        GRAPH_SERVICE_LEVEL.capability()
+    ))
+}
+
+/// Whether `e` is the [`level_refused`] registration error.
+fn is_level_refused(e: &ThreadsError) -> bool {
+    matches!(e, ThreadsError::Rejected(m) if m.starts_with("herdr-threads daemon refused service_session_v"))
+}
+
+/// Map a registration refusal: a daemon that does not serve graph's level answers `Unsupported`
+/// ("unsupported service capability"), which is the named [`level_refused`] error; anything else as usual.
+pub(crate) fn register_error(e: ApiError) -> ThreadsError {
+    match e.code {
+        ErrorCode::Unsupported => level_refused(&e.detail),
+        _ => api_error(e),
+    }
+}
+
+/// A mutation's failure before it is mapped onto the port's error classes: threads' own answer (with whether
+/// its intent stays pending for replay), or a local failure (registration, the intent journal).
+pub(crate) enum MutateError {
+    Api { error: ApiError, pending: bool },
+    Local(ThreadsError),
+}
+
+impl MutateError {
+    fn into_threads(self) -> ThreadsError {
+        match self {
+            Self::Api { error, .. } => api_error(error),
+            Self::Local(e) => e,
+        }
+    }
+}
+
+/// Map the answer to a `ResurrectSeat` (resurrect or the held-seat rebind) onto the port's outcome.
+/// Transient: `ServiceBusy` (also a busy store), `StaleHostObservation`, transport trouble (`Unreachable`) and
+/// an intent left pending by a dropped call (`OutcomeUnknown`, replayed under the same key). Every other
+/// refusal is definitive; a daemon that refused graph's v4 registration, or the operation, is `Unsupported`.
+pub(crate) fn restore_outcome(answer: Result<ServiceResult, MutateError>) -> SeatRestoreOutcome {
+    use SeatRestoreRefusal as R;
+    let reason = match answer {
+        Ok(ServiceResult::SeatResurrected(_)) => return SeatRestoreOutcome::Done,
+        Ok(ServiceResult::SeatAlreadyResolved(_)) => return SeatRestoreOutcome::AlreadyResolved,
+        Ok(_) => R::InvalidRequest,
+        Err(MutateError::Api {
+            error,
+            pending: true,
+        }) => match error.code {
+            ErrorCode::ServiceBusy => R::ServiceBusy,
+            _ => R::OutcomeUnknown,
+        },
+        Err(MutateError::Api {
+            error,
+            pending: false,
+        }) => match error.code {
+            ErrorCode::NotFound => R::NotFound,
+            ErrorCode::Unauthorized | ErrorCode::CallerUnverified => R::Unauthorized,
+            ErrorCode::TargetAlreadyOwned => R::TargetAlreadyOwned,
+            ErrorCode::InstanceMismatch => R::InstanceMismatch,
+            ErrorCode::Unsupported | ErrorCode::UnsupportedHarness => R::Unsupported,
+            ErrorCode::ServiceBusy | ErrorCode::StoreBusy => R::ServiceBusy,
+            ErrorCode::StaleHostObservation => R::StaleHostObservation,
+            ErrorCode::UnknownOutcome => R::OutcomeUnknown,
+            ErrorCode::HostUnavailable
+            | ErrorCode::TransportDenied
+            | ErrorCode::DeadlineExceeded
+            | ErrorCode::Cancelled
+            | ErrorCode::StaleServiceGeneration
+            | ErrorCode::ServiceNotRegistered
+            | ErrorCode::DaemonBootChanged => R::Unreachable,
+            // InvalidRequest (replace on a held seat, a bad id), OperationPayloadMismatch (the key reused with
+            // another payload) and every other refusal.
+            _ => R::InvalidRequest,
+        },
+        Err(MutateError::Local(e)) if is_level_refused(&e) => R::Unsupported,
+        Err(MutateError::Local(e)) => return SeatRestoreOutcome::from_error(&e),
+    };
+    SeatRestoreOutcome::refused(reason)
+}
