+        }))
+    }
+
+    /// One `ResurrectSeat` under `op`. Threads stores only a success under the key (a replay returns it, and
+    /// the same key with another payload is refused); a refusal rolls back and stores nothing. The client's
+    /// intent journal does keep a refusal as the key's completion, so it is forgotten here: a retry under the
+    /// same key (a `NotFound` or `StaleHostObservation` retried) is a fresh decision, never the cached refusal.
+    /// A busy or dropped call stays pending and is replayed with its original envelope.
+    async fn restore(
+        &self,
+        seat: &ThreadsSeatRef,
+        pane: &HerdrPaneId,
+        replace: Option<&ThreadsSeatRef>,
+        op: &OpKey,
+    ) -> SeatRestoreOutcome {
+        let request = match self.resurrect_request(seat, pane, replace, op) {
+            Ok(r) => r,
+            Err(e) => return SeatRestoreOutcome::from_error(&e),
+        };
+        let key = operation_id(op);
+        let answer = self.mutate_raw(request).await;
+        if matches!(answer, Err(MutateError::Api { pending: false, .. })) {
+            let _ = self.client.journal().forget_completed(&key);
+        }
+        restore_outcome(answer)
+    }
+}
