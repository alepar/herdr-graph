+    fn retext(mut r: RenderedInstructions) -> RenderedInstructions {
+        r.text = revision_line(&r.seat_name, &r.seat, short_rev(&r.rev));
+        r.text.push('\n');
+        for p in &r.parts {
+            r.text
+                .push_str(&format!("\n## {} — {}\n{}", p.label, p.path, p.body));
+        }
+        r
