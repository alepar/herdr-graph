+    #[test]
+    fn graph_id_prefix_listed_and_no_prefix_is_a_prefix_of_another() {
+        assert!(
+            IdKind::ALL
+                .iter()
+                .any(|(k, p)| *k == IdKind::Graph && *p == "gr_")
+        );
+        assert_eq!(IdKind::Graph.prefix(), "gr_");
+        for (i, a) in IdKind::ALL.iter().enumerate() {
+            for (j, b) in IdKind::ALL.iter().enumerate() {
+                if i != j {
+                    assert!(!b.1.starts_with(a.1), "{} is a prefix of {}", a.1, b.1);
+                }
+            }
+        }
+    }
