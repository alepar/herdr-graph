+    #[test]
+    fn parse_words_shapes() {
+        let r = parse_words(&words("global rules/x.md"), true).unwrap();
+        assert_eq!(
+            r,
+            InstructionRef {
+                scope: ScopeKind::Global,
+                target: None,
+                file: Some(InstructionFile::Rule("x".into()))
+            }
+        );
+        let r = parse_words(&words("teamspace alpha rules/x.md"), true).unwrap();
+        assert_eq!(
+            (r.scope, r.target.as_deref()),
+            (ScopeKind::Teamspace, Some("alpha"))
+        );
+        let r = parse_words(&words("seat a1 AGENTS.md"), true).unwrap();
+        assert_eq!(r.file, Some(InstructionFile::AgentsMd));
+        let r = parse_words(&words("seat a1"), false).unwrap();
+        assert_eq!((r.target.as_deref(), r.file), (Some("a1"), None));
+        let r = parse_words(&words("global"), false).unwrap();
+        assert_eq!((r.scope, r.file), (ScopeKind::Global, None));
+        for (w, req) in [
+            ("seat a1", true),
+            ("global", true),
+            ("global foo rules/x.md", true),
+            ("bogus x", true),
+            ("seat", false),
+            ("seat a1 AGENTS.md extra", true),
+            ("", true),
+        ] {
+            assert!(
+                matches!(parse_words(&words(w), req), Err(InstructionError::Usage(_))),
+                "{w:?}"
+            );
+        }
+    }
