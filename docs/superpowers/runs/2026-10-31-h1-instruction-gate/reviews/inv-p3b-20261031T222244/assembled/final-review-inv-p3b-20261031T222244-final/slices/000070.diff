+    /// alpha: live a1, a2, retired old; beta: live b1; retired teamspace gone with seat g1.
+    fn fixture() -> Fx {
+        let (t, store) = new_instance();
+        let mut e = EditSet::default();
+        let put_ts = |e: &mut EditSet, slug: &str, name: &str, lc: Lifecycle| {
+            let mut ts = teamspace(name);
+            ts.lifecycle = lc;
+            let dir = layout::teamspace_dir(slug);
+            e.put(layout::teamspace_record(&dir), toml_bytes(&ts));
+            (ts, dir)
+        };
+        let put_seat =
+            |e: &mut EditSet, dir: &RepoPath, ts: &TeamspaceRecord, name: &str, lc: Lifecycle| {
+                let mut s = seat(name, &ts.id);
+                s.lifecycle = lc;
+                let sd = layout::seat_dir(dir, name);
+                e.put(layout::seat_record(&sd), toml_bytes(&s));
+                (s, sd)
+            };
+        let (alpha, ad) = put_ts(&mut e, "alpha", "alpha", Lifecycle::Active);
+        let (beta, bd) = put_ts(&mut e, "beta", "beta", Lifecycle::Dormant);
+        let (gone, gd) = put_ts(&mut e, "gone", "gone", Lifecycle::Retired);
+        let (a1, a1_dir) = put_seat(&mut e, &ad, &alpha, "a1", Lifecycle::Active);
+        put_seat(&mut e, &ad, &alpha, "a2", Lifecycle::Dormant);
+        let (old, _) = put_seat(&mut e, &ad, &alpha, "old", Lifecycle::Retired);
+        put_seat(&mut e, &bd, &beta, "b1", Lifecycle::Active);
+        put_seat(&mut e, &gd, &gone, "g1", Lifecycle::Active);
+        let head = commit_edits(&store, &e, "fixture");
+        Fx {
+            _t: t,
+            store,
+            head,
+            alpha,
+            gone,
+            a1,
+            old,
+            a1_dir,
+        }
+    }
