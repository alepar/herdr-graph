+    #[test]
+    fn classify_paths() {
+        for f in [FolderKind::Seat, FolderKind::Teamspace, FolderKind::Root] {
+            for rel in [
+                "AGENTS.md",
+                "rules/x.md",
+                "rules/Code-Style.md",
+                "rules/a/b.md",
+            ] {
+                assert_eq!(classify(f, rel), PathClass::Instruction, "{rel}");
+                assert!(is_instruction_source(f, rel));
+            }
+        }
+        for rel in [
+            "seat.toml",
+            "clones/c/clone.toml",
+            "teamspace.toml",
+            "graph.toml",
+            "template.toml",
+        ] {
+            assert_eq!(classify(FolderKind::Seat, rel), PathClass::Record, "{rel}");
+        }
+        for f in [FolderKind::Seat, FolderKind::Clone] {
+            for rel in ["notes/n.md", "summaries/tr-0-5.md"] {
+                assert_eq!(classify(f, rel), PathClass::Data, "{rel}");
+                assert!(!is_instruction_source(f, rel));
+            }
+            for rel in [".gitkeep", "rules/.gitkeep", "notes/.x"] {
+                assert_eq!(classify(f, rel), PathClass::Ignored, "{rel}");
+            }
+        }
+        assert_eq!(classify(FolderKind::Clone, "clone.toml"), PathClass::Record);
+        // A clone's rules/ or AGENTS.md is plain data: instructions live on seats.
+        assert_eq!(classify(FolderKind::Clone, "AGENTS.md"), PathClass::Data);
+        assert_eq!(layout::RECORD_FILES.len(), 5);
+    }
