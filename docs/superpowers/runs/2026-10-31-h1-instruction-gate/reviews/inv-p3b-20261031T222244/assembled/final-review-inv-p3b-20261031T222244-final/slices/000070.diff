+    #[test]
+    fn ambiguous_live_name_lists_ids() {
+        let fx = fixture();
+        // A second live seat named a1 in beta.
+        let beta =
+            resolve_scope(&fx.store.at(&fx.head), ScopeKind::Teamspace, Some("beta")).unwrap();
+        let InstructionScope::Teamspace(beta_id) = beta else {
+            panic!()
+        };
+        let dup = seat("a1", &beta_id);
+        let mut e = EditSet::default();
+        e.put(
+            layout::seat_record(&layout::seat_dir(&layout::teamspace_dir("beta"), "dup")),
+            toml_bytes(&dup),
+        );
+        let c = commit_edits(&fx.store, &e, "dup");
+        let err = resolve_scope(&fx.store.at(&c), ScopeKind::Seat, Some("a1")).unwrap_err();
+        match err {
+            InstructionError::Ambiguous(m) => {
+                assert!(
+                    m.contains(fx.a1.id.as_str()) && m.contains(dup.id.as_str()),
+                    "{m}"
+                )
+            }
+            other => panic!("{other:?}"),
+        }
+    }
