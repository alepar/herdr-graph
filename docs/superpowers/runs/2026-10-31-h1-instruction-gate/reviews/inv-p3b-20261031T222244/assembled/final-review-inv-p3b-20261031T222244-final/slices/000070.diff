+    #[test]
+    fn file_names_and_allowed_files() {
+        for w in [
+            "rules/Code-Style.md",
+            "rules/a/b.md",
+            "rules/.x.md",
+            "rules/x.txt",
+            "rules/.md",
+        ] {
+            assert!(
+                matches!(
+                    InstructionFile::parse(ScopeKind::Seat, w),
+                    Err(InstructionError::BadName(_))
+                ),
+                "{w}"
+            );
+        }
+        assert!(matches!(
+            InstructionFile::parse(ScopeKind::Global, "AGENTS.md"),
+            Err(InstructionError::NotAllowed { .. })
+        ));
+        assert!(matches!(
+            InstructionFile::parse(ScopeKind::Teamspace, "AGENTS.md"),
+            Err(InstructionError::NotAllowed { .. })
+        ));
+        assert!(matches!(
+            InstructionFile::parse(ScopeKind::Seat, "notes.md"),
+            Err(InstructionError::NotAllowed { .. })
+        ));
+        assert_eq!(
+            InstructionFile::parse(ScopeKind::Seat, "AGENTS.md"),
+            Ok(InstructionFile::AgentsMd)
+        );
+        let ok = InstructionFile::parse(ScopeKind::Global, "rules/a_b-9.md").unwrap();
+        assert_eq!(ok.rel(), "rules/a_b-9.md");
+        // Distinct errors: unknown and retired targets are other variants again.
+        let fx = fixture();
+        let v = fx.store.at(&fx.head);
+        let unknown = resolve_scope(&v, ScopeKind::Seat, Some("nope")).unwrap_err();
+        let retired = resolve_scope(&v, ScopeKind::Seat, Some("old")).unwrap_err();
+        assert!(matches!(unknown, InstructionError::UnknownTarget { .. }));
+        assert!(matches!(retired, InstructionError::Retired { .. }));
+    }
