+    #[test]
+    fn list_files_reports_bad_names() {
+        let fx = fixture();
+        let mut e = EditSet::default();
+        for f in [
+            "rules/ok.md",
+            "rules/Bad.md",
+            "rules/n/x.md",
+            "rules/.keep",
+            "AGENTS.md",
+        ] {
+            e.put(fx.a1_dir.join(f).unwrap(), b"x\n".to_vec());
+        }
+        e.put(fx.a1_dir.join("notes/n.md").unwrap(), b"data".to_vec());
+        let c = commit_edits(&fx.store, &e, "files");
+        let v = fx.store.at(&c);
+        let listed = list_files(&v, &InstructionScope::Seat(fx.a1.id.clone())).unwrap();
+        let rels: Vec<&str> = listed.iter().map(|l| l.rel.as_str()).collect();
+        assert_eq!(
+            rels,
+            ["AGENTS.md", "rules/Bad.md", "rules/n/x.md", "rules/ok.md"]
+        );
+        let ok: Vec<bool> = listed.iter().map(|l| l.name.is_ok()).collect();
+        assert_eq!(ok, [true, false, false, true]);
+        assert_eq!(listed[3].name, Ok(InstructionFile::Rule("ok".into())));
+        assert_eq!(listed[3].path, fx.a1_dir.join("rules/ok.md").unwrap());
+        assert!(
+            listed[1]
+                .name
+                .as_ref()
+                .unwrap_err()
+                .to_string()
+                .contains("rules/Bad.md")
+        );
+        // Same checker for a scope with no AGENTS.md.
+        assert!(check_name(ScopeKind::Teamspace, "AGENTS.md").is_err());
+        assert!(check_name(ScopeKind::Seat, "AGENTS.md").is_ok());
+    }
