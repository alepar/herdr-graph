+    #[test]
+    fn content_clause() {
+        assert_eq!(check_content(b"a\tb\nc\r\nd"), Ok("a\tb\nc\r\nd"));
+        assert_eq!(check_content(b"\r\n"), Ok("\r\n"));
+        assert_eq!(check_content("héllo ✓".as_bytes()), Ok("héllo ✓"));
+        let reason = |b: &[u8]| check_content(b).unwrap_err().reason;
+        assert_eq!(reason(b"\x1b[31m"), "control character U+001B at line 1");
+        assert_eq!(reason(b"a\rb"), "bare carriage return (U+000D) at line 1");
+        assert_eq!(reason(b"a\r"), "bare carriage return (U+000D) at line 1");
+        assert_eq!(
+            reason("x\n\u{0085}".as_bytes()),
+            "control character U+0085 at line 2"
+        );
+        assert_eq!(reason(b"\x7f"), "control character U+007F at line 1");
+        assert_eq!(reason(b"\n\n\x00"), "control character U+0000 at line 3");
+        assert_eq!(reason(b"ab\xff"), "not valid UTF-8 (at byte 2)");
+        assert_eq!(reason(&[0xff]), "not valid UTF-8 (at byte 0)");
+        for c in [
+            '\u{AD}',
+            '\u{61C}',
+            '\u{180E}',
+            '\u{200B}',
+            '\u{200F}',
+            '\u{202A}',
+            '\u{202E}',
+            '\u{2060}',
+            '\u{2064}',
+            '\u{2066}',
+            '\u{206F}',
+            '\u{FEFF}',
+            '\u{FFF9}',
+            '\u{FFFB}',
+            '\u{E0000}',
+            '\u{E0041}',
+            '\u{E007F}',
+        ] {
+            let text = format!("ok\n{c}");
+            let r = reason(text.as_bytes());
+            assert_eq!(
+                r,
+                format!("invisible or format character U+{:04X} at line 2", c as u32)
+            );
+        }
+        assert!(reason("\u{E0041}".as_bytes()).contains("U+E0041"));
+        // Neighbours just outside the ranges are admissible.
+        for c in [
+            '\u{AE}',
+            '\u{2065}',
+            '\u{2070}',
+            '\u{FFFC}',
+            '\u{E0080}',
+            '\u{200A}',
+            '\u{2029}',
+        ] {
+            let s = c.to_string();
+            assert_eq!(
+                check_content(s.as_bytes()),
+                Ok(s.as_str()),
+                "U+{:04X}",
+                c as u32
+            );
+        }
+    }
